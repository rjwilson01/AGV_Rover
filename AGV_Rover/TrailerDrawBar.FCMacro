import FreeCAD as App
import FreeCADGui as Gui
import Part
import math

try:
    from PySide6 import QtCore, QtWidgets
    Qt = QtCore.Qt
except ImportError:
    from PySide2 import QtCore, QtWidgets
    Qt = QtCore.Qt

# --- PARAMETRIC DIMENSIONS (mm) ---
TRAILER_WIDTH = 500.0       # Width of AGV rear & trailer front reference plates
PLATE_THICK = 10.0
DRAWBAR_LEN = 350.0         # Length from each vehicle body to the ball joint center
DRAWBAR_DIA = 50.0          # 50mm round drawbar tube
BALL_DIA = 55.0             # Central ball joint sphere

# Option 2: Angled Clamps + Stiff Bend-Relief Boots/Springs
CLAMP_OFFSET = 200.0        # Distance from ball joint center to clamp pivot
CLAMP_BASE_Z = 28.0         # Height above drawbar center (25mm radius + 3mm saddle)
CLAMP_BODY_LEN = 26.0       # Length of angled clamp saddle
BOOT_LEN = 65.0             # Length of stiff ribbed rubber/spring bend-relief boot
CABLE_DIA = 10.0            # 10mm OD hybrid robotic cable

# 4-Corner Pull-Pull Steel Control Cables (Actively Tensioned Capstans)
STEEL_CABLE_DIA = 3.0       # 3mm steel cable

doc = App.ActiveDocument or App.newDocument("AGV_4Corner_Option2_Sim")
for obj in doc.Objects:
    doc.removeObject(obj.Name)

# Fixed AGV side parts
agv_plate = doc.addObject("Part::Feature", "AGV_Rear_Plate")
agv_plate.ViewObject.ShapeColor = (0.20, 0.35, 0.55)
agv_plate.ViewObject.Transparency = 60

agv_bar = doc.addObject("Part::Feature", "AGV_Drawbar_50mm")
agv_bar.Shape = Part.makeCylinder(DRAWBAR_DIA / 2.0, DRAWBAR_LEN, App.Vector(-DRAWBAR_LEN, 0, 0), App.Vector(1, 0, 0))
agv_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

ball_joint = doc.addObject("Part::Feature", "Ball_Joint")
ball_joint.Shape = Part.makeSphere(BALL_DIA / 2.0, App.Vector(0, 0, 0))
ball_joint.ViewObject.ShapeColor = (0.85, 0.55, 0.15)

agv_clamp_obj = doc.addObject("Part::Feature", "AGV_Angled_Clamp")
agv_clamp_obj.ViewObject.ShapeColor = (0.15, 0.15, 0.17)

agv_boot_obj = doc.addObject("Part::Feature", "AGV_Bend_Relief_Boot")
agv_boot_obj.ViewObject.ShapeColor = (0.25, 0.27, 0.30)

# Rotating Trailer side parts (around ball joint at 0,0,0)
trailer_bar = doc.addObject("Part::Feature", "Trailer_Drawbar_50mm")
trailer_bar.Shape = Part.makeCylinder(DRAWBAR_DIA / 2.0, DRAWBAR_LEN, App.Vector(0, 0, 0), App.Vector(1, 0, 0))
trailer_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

trailer_plate = doc.addObject("Part::Feature", "Trailer_Front_Plate")
trailer_plate.ViewObject.ShapeColor = (0.25, 0.55, 0.35)
trailer_plate.ViewObject.Transparency = 60

trl_clamp_obj = doc.addObject("Part::Feature", "Trailer_Angled_Clamp")
trl_clamp_obj.ViewObject.ShapeColor = (0.15, 0.15, 0.17)

trl_boot_obj = doc.addObject("Part::Feature", "Trailer_Bend_Relief_Boot")
trl_boot_obj.ViewObject.ShapeColor = (0.25, 0.27, 0.30)

# Electrical Hybrid Jumper Loop (Active flexing section between boot tips)
elec_cable_obj = doc.addObject("Part::Feature", "Elec_Jumper_10mm")
elec_cable_obj.ViewObject.ShapeColor = (0.95, 0.45, 0.05)

# 4 Corner Pull-Pull Steel Cables
steel_names = [
    "Corner_Top_Left_3mm",
    "Corner_Top_Right_3mm",
    "Corner_Bot_Left_3mm",
    "Corner_Bot_Right_3mm",
]
base_colors = [
    (0.85, 0.20, 0.20),
    (0.85, 0.20, 0.20),
    (0.15, 0.70, 0.85),
    (0.15, 0.70, 0.85),
]
steel_objs = []
for name, col in zip(steel_names, base_colors):
    obj = doc.addObject("Part::Feature", name)
    obj.ViewObject.ShapeColor = col
    steel_objs.append(obj)

def make_clamp_and_boot(base_pt, axis_dir, radius):
    clamp_start = base_pt - axis_dir * (CLAMP_BODY_LEN * 0.5)
    clamp_shape = Part.makeBox(
        CLAMP_BODY_LEN,
        24.0,
        22.0,
        App.Vector(-CLAMP_BODY_LEN * 0.5, -12.0, -11.0)
    )
    angle_deg = math.degrees(math.atan2(axis_dir.z, axis_dir.x))
    rot = App.Rotation(App.Vector(0, 1, 0), -angle_deg)
    clamp_shape.Placement = App.Placement(base_pt, rot)

    boot_start = base_pt + axis_dir * (CLAMP_BODY_LEN * 0.5)
    boot_tip = boot_start + axis_dir * BOOT_LEN
    boot_shape = Part.makeCone(radius + 4.5, radius + 1.8, BOOT_LEN, boot_start, axis_dir)
    return clamp_shape, boot_shape, boot_tip

def build_elec_cable_shape(p0, t0, p1, t1, target_len, radius):
    chord = p0.distanceToPoint(p1)
    eff_len = max(target_len, chord + 12.0)

    low, high = 5.0, 260.0
    best_wire = None
    best_apex_z = 0.0
    max_arm = max(25.0, chord * 0.34)

    for _ in range(20):
        mid = 0.5 * (low + high)
        arm = min(max_arm, 20.0 + mid * 0.65)
        q0 = p0 + t0 * arm
        q3 = p1 + t1 * arm
        q_mid = (q0 + q3) * 0.5 + App.Vector(0, 0, mid)
        bs = Part.BSplineCurve()
        bs.buildFromPoles([p0, q0, q_mid, q3, p1])
        wire = Part.Wire(bs.toShape())
        if wire.Length < eff_len:
            low = mid
        else:
            high = mid
        best_wire = wire
        best_apex_z = q_mid.z

    profile = Part.Wire(Part.makeCircle(radius, p0, t0))
    return best_wire.makePipeShell([profile], True, True), best_wire.Length, best_apex_z

def build_taut_cable_shape(p0, p1, radius):
    edge = Part.makeLine(p0, p1)
    wire = Part.Wire(edge)
    tangent = (p1 - p0).normalize()
    profile = Part.Wire(Part.makeCircle(radius, p0, tangent))
    return wire.makePipeShell([profile], True, True), wire.Length

class CableSimDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("AGV 4-Corner Capstan & Option 2 Boot Sim")
        self.setWindowFlags(self.windowFlags() | Qt.WindowStaysOnTopHint)
        self.resize(450, 440)

        layout = QtWidgets.QVBoxLayout(self)

        self.yaw_slider, self.yaw_lbl = self._make_slider(layout, "Yaw (Turn):", -90, 90, 0, "°")
        self.pitch_slider, self.pitch_lbl = self._make_slider(layout, "Pitch (Hill):", -30, 30, 0, "°")
        self.roll_slider, self.roll_lbl = self._make_slider(layout, "Roll (Tilt):", -30, 30, 0, "°")
        self.launch_slider, self.launch_lbl = self._make_slider(layout, "Clamp Launch:", 0, 50, 30, "°")
        self.loop_slider, self.loop_lbl = self._make_slider(layout, "Free Loop Len:", 280, 520, 340, " mm")
        self.corner_y_slider, self.corner_y_lbl = self._make_slider(layout, "Corner ±Y Dist:", 60, 250, 240, " mm")
        self.corner_z_slider, self.corner_z_lbl = self._make_slider(layout, "Corner ±Z Dist:", 50, 220, 135, " mm")

        self.autopause_chk = QtWidgets.QCheckBox("Auto-Pause Sweep on Interference Warning")
        self.autopause_chk.setChecked(True)
        layout.addWidget(self.autopause_chk)

        self.info_lbl = QtWidgets.QLabel()
        self.info_lbl.setStyleSheet("font-weight: bold; padding: 8px; background: #222; color: #0f0; border-radius: 4px;")
        layout.addWidget(self.info_lbl)

        btn_row = QtWidgets.QHBoxLayout()
        self.play_btn = QtWidgets.QPushButton("Play Sweep (±60°)")
        self.play_btn.setCheckable(True)
        self.reset_btn = QtWidgets.QPushButton("Reset (0°)")
        btn_row.addWidget(self.play_btn)
        btn_row.addWidget(self.reset_btn)
        layout.addLayout(btn_row)

        for s in (
            self.yaw_slider,
            self.pitch_slider,
            self.roll_slider,
            self.launch_slider,
            self.loop_slider,
            self.corner_y_slider,
            self.corner_z_slider,
        ):
            s.valueChanged.connect(self.on_slider_change)

        self.play_btn.toggled.connect(self.on_play_toggled)
        self.reset_btn.clicked.connect(self.on_reset)

        self.step = 0
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.on_timer)

        self.update_pose()

    def _make_slider(self, parent_layout, title, min_v, max_v, init_v, unit):
        row = QtWidgets.QHBoxLayout()
        lbl = QtWidgets.QLabel(f"{title} {init_v}{unit}")
        lbl.setFixedWidth(145)
        slider = QtWidgets.QSlider(Qt.Horizontal)
        slider.setRange(min_v, max_v)
        slider.setValue(init_v)
        row.addWidget(lbl)
        row.addWidget(slider)
        parent_layout.addLayout(row)
        return slider, lbl

    def update_pose(self):
        yaw_deg = self.yaw_slider.value()
        pitch_deg = self.pitch_slider.value()
        roll_deg = self.roll_slider.value()
        launch_deg = self.launch_slider.value()
        free_loop_len = float(self.loop_slider.value())
        corner_y = float(self.corner_y_slider.value())
        corner_z = float(self.corner_z_slider.value())

        self.yaw_lbl.setText(f"Yaw (Turn): {yaw_deg}°")
        self.pitch_lbl.setText(f"Pitch (Hill): {pitch_deg}°")
        self.roll_lbl.setText(f"Roll (Tilt): {roll_deg}°")
        self.launch_lbl.setText(f"Clamp Launch: {launch_deg}°")
        self.loop_lbl.setText(f"Free Loop Len: {int(free_loop_len)} mm")
        self.corner_y_lbl.setText(f"Corner ±Y Dist: {int(corner_y)} mm")
        self.corner_z_lbl.setText(f"Corner ±Z Dist: {int(corner_z)} mm")

        plate_h = max(240.0, (corner_z + 25.0) * 2.0)
        agv_plate.Shape = Part.makeBox(
            PLATE_THICK,
            TRAILER_WIDTH,
            plate_h,
            App.Vector(-DRAWBAR_LEN - PLATE_THICK, -TRAILER_WIDTH / 2.0, -plate_h / 2.0),
        )
        trailer_plate.Shape = Part.makeBox(
            PLATE_THICK,
            TRAILER_WIDTH,
            plate_h,
            App.Vector(DRAWBAR_LEN, -TRAILER_WIDTH / 2.0, -plate_h / 2.0),
        )

        rot = App.Rotation(yaw_deg, pitch_deg, roll_deg)
        placement = App.Placement(App.Vector(0, 0, 0), rot)
        trailer_bar.Placement = placement
        trailer_plate.Placement = placement

        launch_rad = math.radians(launch_deg)
        agv_base = App.Vector(-CLAMP_OFFSET, 0, CLAMP_BASE_Z)
        agv_dir = App.Vector(math.cos(launch_rad), 0, math.sin(launch_rad)).normalize()
        c_agv_shp, b_agv_shp, ep0 = make_clamp_and_boot(agv_base, agv_dir, CABLE_DIA / 2.0)
        agv_clamp_obj.Shape = c_agv_shp
        agv_boot_obj.Shape = b_agv_shp

        trl_base = App.Vector(CLAMP_OFFSET, 0, CLAMP_BASE_Z)
        trl_dir = App.Vector(-math.cos(launch_rad), 0, math.sin(launch_rad)).normalize()
        c_trl_shp, b_trl_shp, ep1_local = make_clamp_and_boot(trl_base, trl_dir, CABLE_DIA / 2.0)
        trl_clamp_obj.Shape = c_trl_shp
        trl_boot_obj.Shape = b_trl_shp
        trl_clamp_obj.Placement = placement
        trl_boot_obj.Placement = placement

        ep1 = placement.multVec(ep1_local)
        et1 = rot.multVec(trl_dir)
        elec_shape, actual_free_len, apex_z = build_elec_cable_shape(
            ep0, agv_dir, ep1, et1, free_loop_len, CABLE_DIA / 2.0
        )
        elec_cable_obj.Shape = elec_shape

        total_clamp_to_clamp = actual_free_len + 2.0 * (CLAMP_BODY_LEN * 0.5 + BOOT_LEN)

        # 4 Corner Pull-Pull Steel Cables (Plate-to-Plate)
        anchors_local = [
            (App.Vector(-DRAWBAR_LEN,  corner_y,  corner_z), App.Vector(DRAWBAR_LEN,  corner_y,  corner_z)),  # Top-Left
            (App.Vector(-DRAWBAR_LEN, -corner_y,  corner_z), App.Vector(DRAWBAR_LEN, -corner_y,  corner_z)),  # Top-Right
            (App.Vector(-DRAWBAR_LEN,  corner_y, -corner_z), App.Vector(DRAWBAR_LEN,  corner_y, -corner_z)),  # Bot-Left
            (App.Vector(-DRAWBAR_LEN, -corner_y, -corner_z), App.Vector(DRAWBAR_LEN, -corner_y, -corner_z)),  # Bot-Right
        ]

        lengths = []
        clash_details = []
        min_overall_gap = 9999.0

        # Build named obstacle list using world-transformed shapes (ignoring the end plates themselves!)
        trl_clamp_world = trl_clamp_obj.Shape.copy()
        trl_clamp_world.Placement = placement
        trl_boot_world = trl_boot_obj.Shape.copy()
        trl_boot_world.Placement = placement
        trl_bar_world = trailer_bar.Shape.copy()
        trl_bar_world.Placement = placement

        obstacles = [
            ("AGV Drawbar", agv_bar.Shape),
            ("Trailer Drawbar", trl_bar_world),
            ("Ball Joint", ball_joint.Shape),
            ("AGV Clamp", agv_clamp_obj.Shape),
            ("Trailer Clamp", trl_clamp_world),
            ("AGV Boot", agv_boot_obj.Shape),
            ("Trailer Boot", trl_boot_world),
            ("Elec Loop", elec_cable_obj.Shape),
        ]

        for idx, (a0, a1_local) in enumerate(anchors_local):
            p0 = a0
            p1 = placement.multVec(a1_local)
            shape, c_len = build_taut_cable_shape(p0, p1, STEEL_CABLE_DIA / 2.0)
            steel_objs[idx].Shape = shape
            lengths.append(c_len)

            hit_obs = []
            for obs_name, obs_shape in obstacles:
                # distToShape returns (dist, pts, geom)
                dist_val = float(shape.distToShape(obs_shape)[0])
                if dist_val < min_overall_gap:
                    min_overall_gap = dist_val
                if dist_val < 0.5:
                    hit_obs.append(obs_name)

            if hit_obs:
                steel_objs[idx].ViewObject.ShapeColor = (1.0, 0.85, 0.0)
                clash_details.append(f"{steel_names[idx]} -> {', '.join(hit_obs)}")
            else:
                steel_objs[idx].ViewObject.ShapeColor = base_colors[idx]

        doc.recompute()

        if clash_details:
            if self.play_btn.isChecked() and self.autopause_chk.isChecked():
                self.play_btn.setChecked(False)
                status_line = f"AUTO-PAUSED: {'; '.join(clash_details)}"
            else:
                status_line = f"WARNING: {'; '.join(clash_details)}"
            color_hex = "#ff4444"
        else:
            status_line = f"Clearance OK (Min gap: {min_overall_gap:.1f} mm)"
            color_hex = "#00ff66"

        self.info_lbl.setStyleSheet(
            f"font-weight: bold; padding: 8px; background: #222; color: {color_hex}; border-radius: 4px;"
        )
        self.info_lbl.setText(
            f"{status_line}\n"
            f"Loop Apex Z: {apex_z:.0f} mm  |  Total Clamp-to-Clamp Cable: {total_clamp_to_clamp:.0f} mm\n"
            f"Top L/R: {lengths[0]:.0f} / {lengths[1]:.0f} mm  |  Bot L/R: {lengths[2]:.0f} / {lengths[3]:.0f} mm"
        )

    def on_slider_change(self):
        self.update_pose()

    def on_play_toggled(self, checked):
        if checked:
            self.play_btn.setText("Pause Sweep")
            self.timer.start(35)
        else:
            self.play_btn.setText("Play Sweep (±60°)")
            self.timer.stop()

    def on_reset(self):
        self.play_btn.setChecked(False)
        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(True)
        self.yaw_slider.setValue(0)
        self.pitch_slider.setValue(0)
        self.roll_slider.setValue(0)
        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(False)
        self.update_pose()

    def on_timer(self):
        t = self.step * 0.06
        yaw = int(round(60.0 * math.sin(t)))
        pitch = int(round(15.0 * math.sin(t * 2.0)))
        roll = int(round(15.0 * math.cos(t)))

        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(True)
        self.yaw_slider.setValue(yaw)
        self.pitch_slider.setValue(pitch)
        self.roll_slider.setValue(roll)
        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(False)

        self.update_pose()
        self.step += 1

    def closeEvent(self, event):
        self.timer.stop()
        super().closeEvent(event)

for w in QtWidgets.QApplication.topLevelWidgets():
    if w.objectName() == "AGV_Cable_Sim_Dialog":
        w.close()

dlg = CableSimDialog(Gui.getMainWindow())
dlg.setObjectName("AGV_Cable_Sim_Dialog")
dlg.show()
Gui.SendMsgToActiveView("ViewFit")
