import FreeCAD as App
import FreeCADGui as Gui
import Part
import math

try:
    from PySide6 import QtCore, QtWidgets
    Qt = QtCore.Qt
except ImportError:
    from PySide2 import QtCore, QtWidgets
    Qt = QtCore.Qt

# --- PARAMETRIC DIMENSIONS (mm) ---
TRAILER_WIDTH = 500.0       # Width of AGV rear & trailer front reference plates
PLATE_HEIGHT = 360.0        # Height of reference plates
PLATE_THICK = 10.0
DRAWBAR_LEN = 350.0         # Length from each vehicle body to the ball joint center
DRAWBAR_DIA = 50.0          # 50mm round drawbar tube
BALL_DIA = 55.0             # Central ball joint sphere

# Electrical Hybrid Jumper Cable (Top-Center Loop)
CLAMP_OFFSET = 200.0        # Distance from ball joint center to each electrical clamp
CLAMP_HEIGHT = 32.0         # Clamp centerline height above drawbar center
CABLE_DIA = 10.0            # 10mm OD hybrid robotic cable

# Actively Tensioned 3mm Steel Pull-Pull Cables (Capstan Fairlead to Trailer Anchor)
STEEL_CABLE_DIA = 3.0       # 3mm steel cable
YAW_ANCHOR_Y = 250.0        # Left/Right anchor offset at max outer edges of 500mm plates
YAW_ANCHOR_Z = 0.0          # Vertical offset for yaw cables
PITCH_ANCHOR_Z = 155.0      # Top/Bottom pitch anchor height

doc = App.ActiveDocument or App.newDocument("AGV_Capstan_PullPull_Sim")
for obj in doc.Objects:
    doc.removeObject(obj.Name)

# Create solid parts
agv_plate = doc.addObject("Part::Feature", "AGV_Rear_Plate")
agv_plate.Shape = Part.makeBox(PLATE_THICK, TRAILER_WIDTH, PLATE_HEIGHT, App.Vector(-DRAWBAR_LEN - PLATE_THICK, -TRAILER_WIDTH/2, -PLATE_HEIGHT/2))
agv_plate.ViewObject.ShapeColor = (0.20, 0.35, 0.55)
agv_plate.ViewObject.Transparency = 60

agv_bar = doc.addObject("Part::Feature", "AGV_Drawbar_50mm")
agv_bar.Shape = Part.makeCylinder(DRAWBAR_DIA/2, DRAWBAR_LEN, App.Vector(-DRAWBAR_LEN, 0, 0), App.Vector(1, 0, 0))
agv_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

ball_joint = doc.addObject("Part::Feature", "Ball_Joint")
ball_joint.Shape = Part.makeSphere(BALL_DIA/2, App.Vector(0, 0, 0))
ball_joint.ViewObject.ShapeColor = (0.85, 0.55, 0.15)

clamp_agv = doc.addObject("Part::Feature", "Clamp_AGV_200mm")
clamp_agv.Shape = Part.makeCylinder(12, 24, App.Vector(-CLAMP_OFFSET - 12, 0, CLAMP_HEIGHT), App.Vector(1, 0, 0))
clamp_agv.ViewObject.ShapeColor = (0.15, 0.15, 0.15)

# Trailer group (rotates around ball joint at 0,0,0)
trailer_bar = doc.addObject("Part::Feature", "Trailer_Drawbar_50mm")
trailer_bar.Shape = Part.makeCylinder(DRAWBAR_DIA/2, DRAWBAR_LEN, App.Vector(0, 0, 0), App.Vector(1, 0, 0))
trailer_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

trailer_plate = doc.addObject("Part::Feature", "Trailer_Front_Plate")
trailer_plate.Shape = Part.makeBox(PLATE_THICK, TRAILER_WIDTH, PLATE_HEIGHT, App.Vector(DRAWBAR_LEN, -TRAILER_WIDTH/2, -PLATE_HEIGHT/2))
trailer_plate.ViewObject.ShapeColor = (0.25, 0.55, 0.35)
trailer_plate.ViewObject.Transparency = 60

clamp_trl = doc.addObject("Part::Feature", "Clamp_Trailer_200mm")
clamp_trl.Shape = Part.makeCylinder(12, 24, App.Vector(CLAMP_OFFSET - 12, 0, CLAMP_HEIGHT), App.Vector(1, 0, 0))
clamp_trl.ViewObject.ShapeColor = (0.15, 0.15, 0.15)

# Electrical loop object (bright orange for clear inspection)
elec_cable_obj = doc.addObject("Part::Feature", "Elec_Jumper_10mm")
elec_cable_obj.ViewObject.ShapeColor = (1.0, 0.42, 0.05)

# 6 Steel Pull-Pull cable objects: Yaw L/R + Twin Top Pitch L/R + Twin Bottom Pitch L/R
steel_names = [
    "Yaw_Left_3mm", "Yaw_Right_3mm",
    "Pitch_Top_Left_3mm", "Pitch_Top_Right_3mm",
    "Pitch_Bot_Left_3mm", "Pitch_Bot_Right_3mm"
]
base_colors = [
    (0.85, 0.20, 0.20), (0.85, 0.20, 0.20),
    (0.10, 0.75, 0.90), (0.10, 0.75, 0.90),
    (0.15, 0.55, 0.85), (0.15, 0.55, 0.85)
]
steel_objs = []
for name, col in zip(steel_names, base_colors):
    obj = doc.addObject("Part::Feature", name)
    obj.ViewObject.ShapeColor = col
    steel_objs.append(obj)

def build_elec_cable_shape(p0, t0, p1, t1, target_len, radius):
    chord = p0.distanceToPoint(p1)
    if target_len <= chord + 2.0:
        edge = Part.makeLine(p0, p1)
        wire = Part.Wire(edge)
        profile = Part.Wire(Part.makeCircle(radius, p0, (p1 - p0).normalize()))
        return wire.makePipeShell([profile], True, True), 0.0

    # Smooth 5-pole Bezier curve (zero kinks/pinching)
    low, high = 5.0, 350.0
    best_wire = None
    best_h = 80.0
    for _ in range(20):
        mid = 0.5 * (low + high)
        up = App.Vector(0, 0, 1)
        p_t0 = p0 + t0 * (chord * 0.28)
        p_t1 = p1 + t1 * (chord * 0.28)
        p_top0 = p_t0 + up * mid
        p_top1 = p_t1 + up * mid
        bs = Part.BSplineCurve()
        bs.buildFromPoles([p0, p_t0, p_top0, p_top1, p_t1, p1])
        wire = Part.Wire(bs.toShape())
        if wire.Length < target_len:
            low = mid
        else:
            high = mid
        best_wire = wire
        best_h = mid * 0.78

    profile = Part.Wire(Part.makeCircle(radius, p0, t0))
    return best_wire.makePipeShell([profile], True, True), best_h

def build_taut_cable_shape(p0, p1, radius):
    edge = Part.makeLine(p0, p1)
    wire = Part.Wire(edge)
    tangent = (p1 - p0).normalize()
    profile = Part.Wire(Part.makeCircle(radius, p0, tangent))
    return wire.makePipeShell([profile], True, True), wire.Length

class CableSimDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("AGV Capstan Pull-Pull & Electrical Loop Sim (v4)")
        self.setWindowFlags(self.windowFlags() | Qt.WindowStaysOnTopHint)
        self.resize(410, 390)

        layout = QtWidgets.QVBoxLayout(self)

        self.yaw_slider, self.yaw_lbl = self._make_slider(layout, "Yaw (Turn):", -90, 90, 0, "°")
        self.pitch_slider, self.pitch_lbl = self._make_slider(layout, "Pitch (Hill):", -30, 30, 0, "°")
        self.roll_slider, self.roll_lbl = self._make_slider(layout, "Roll (Tilt):", -30, 30, 0, "°")
        self.len_slider, self.len_lbl = self._make_slider(layout, "Elec Loop Len:", 430, 650, 500, " mm")
        self.spread_slider, self.spread_lbl = self._make_slider(layout, "Pitch Y-Spread:", 0, 220, 75, " mm")

        self.info_lbl = QtWidgets.QLabel()
        self.info_lbl.setStyleSheet("font-weight: bold; padding: 8px; background: #222; color: #0f0; border-radius: 4px;")
        layout.addWidget(self.info_lbl)

        btn_row = QtWidgets.QHBoxLayout()
        self.play_btn = QtWidgets.QPushButton("Play Sweep (±60°)")
        self.play_btn.setCheckable(True)
        self.reset_btn = QtWidgets.QPushButton("Reset (0°)")
        btn_row.addWidget(self.play_btn)
        btn_row.addWidget(self.reset_btn)
        layout.addLayout(btn_row)

        self.yaw_slider.valueChanged.connect(self.on_slider_change)
        self.pitch_slider.valueChanged.connect(self.on_slider_change)
        self.roll_slider.valueChanged.connect(self.on_slider_change)
        self.len_slider.valueChanged.connect(self.on_slider_change)
        self.spread_slider.valueChanged.connect(self.on_slider_change)
        self.play_btn.toggled.connect(self.on_play_toggled)
        self.reset_btn.clicked.connect(self.on_reset)

        self.step = 0
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.on_timer)

        self.update_pose(0, 0, 0)

    def _make_slider(self, parent_layout, title, min_v, max_v, init_v, unit):
        row = QtWidgets.QHBoxLayout()
        lbl = QtWidgets.QLabel(f"{title} {init_v}{unit}")
        lbl.setFixedWidth(145)
        slider = QtWidgets.QSlider(Qt.Horizontal)
        slider.setRange(min_v, max_v)
        slider.setValue(init_v)
        row.addWidget(lbl)
        row.addWidget(slider)
        parent_layout.addLayout(row)
        return slider, lbl

    def update_pose(self, yaw_deg, pitch_deg, roll_deg):
        elec_len = self.len_slider.value()
        y_spread = self.spread_slider.value()

        self.yaw_lbl.setText(f"Yaw (Turn): {yaw_deg}°")
        self.pitch_lbl.setText(f"Pitch (Hill): {pitch_deg}°")
        self.roll_lbl.setText(f"Roll (Tilt): {roll_deg}°")
        self.len_lbl.setText(f"Elec Loop Len: {elec_len} mm")
        self.spread_lbl.setText(f"Pitch Y-Spread: ±{y_spread} mm")

        rot = App.Rotation(yaw_deg, pitch_deg, roll_deg)
        placement = App.Placement(App.Vector(0, 0, 0), rot)
        trailer_bar.Placement = placement
        trailer_plate.Placement = placement
        clamp_trl.Placement = placement

        # 1. Electrical Hybrid Jumper (Constant length, clamped at +/- 200mm)
        ep0 = App.Vector(-CLAMP_OFFSET, 0, CLAMP_HEIGHT)
        et0 = App.Vector(1, 0, 0)
        ep1 = placement.multVec(App.Vector(CLAMP_OFFSET, 0, CLAMP_HEIGHT))
        et1 = rot.multVec(App.Vector(-1, 0, 0))
        chord = ep0.distanceToPoint(ep1)
        elec_shape, arch_h = build_elec_cable_shape(ep0, et0, ep1, et1, elec_len, CABLE_DIA / 2.0)
        elec_cable_obj.Shape = elec_shape

        # 2. Six Actively Tensioned 3mm Steel Cables:
        # Yaw Left/Right at +/- 250mm, plus Twin Top & Bottom Pitch cables spread symmetrically at +/- y_spread
        anchors_local = [
            (App.Vector(-DRAWBAR_LEN,  YAW_ANCHOR_Y, YAW_ANCHOR_Z), App.Vector(DRAWBAR_LEN,  YAW_ANCHOR_Y, YAW_ANCHOR_Z)),      # Yaw Left (+250)
            (App.Vector(-DRAWBAR_LEN, -YAW_ANCHOR_Y, YAW_ANCHOR_Z), App.Vector(DRAWBAR_LEN, -YAW_ANCHOR_Y, YAW_ANCHOR_Z)),      # Yaw Right (-250)
            (App.Vector(-DRAWBAR_LEN,  y_spread,  PITCH_ANCHOR_Z), App.Vector(DRAWBAR_LEN,  y_spread,  PITCH_ANCHOR_Z)),       # Pitch Top Left (+Y)
            (App.Vector(-DRAWBAR_LEN, -y_spread,  PITCH_ANCHOR_Z), App.Vector(DRAWBAR_LEN, -y_spread,  PITCH_ANCHOR_Z)),       # Pitch Top Right (-Y)
            (App.Vector(-DRAWBAR_LEN,  y_spread, -PITCH_ANCHOR_Z), App.Vector(DRAWBAR_LEN,  y_spread, -PITCH_ANCHOR_Z)),       # Pitch Bot Left (+Y)
            (App.Vector(-DRAWBAR_LEN, -y_spread, -PITCH_ANCHOR_Z), App.Vector(DRAWBAR_LEN, -y_spread, -PITCH_ANCHOR_Z)),       # Pitch Bot Right (-Y)
        ]

        lengths = []
        clash_names = []
        obstacles = [agv_bar.Shape, trailer_bar.Shape, ball_joint.Shape, elec_cable_obj.Shape]

        for idx, (a0, a1_local) in enumerate(anchors_local):
            p0 = a0
            p1 = placement.multVec(a1_local)
            shape, c_len = build_taut_cable_shape(p0, p1, STEEL_CABLE_DIA / 2.0)
            steel_objs[idx].Shape = shape
            lengths.append(c_len)

            min_dist = min(shape.distToShape(obs)[0] for obs in obstacles)
            if min_dist < 1.0:
                steel_objs[idx].ViewObject.ShapeColor = (1.0, 0.85, 0.0)
                clash_names.append(steel_names[idx])
            else:
                steel_objs[idx].ViewObject.ShapeColor = base_colors[idx]

        doc.recompute()

        status_line = f"WARNING - Interference: {', '.join(clash_names)}" if clash_names else "Clearance OK (No cable/tube clash)"
        self.info_lbl.setStyleSheet(
            f"font-weight: bold; padding: 8px; background: #222; color: {'#ff4444' if clash_names else '#00ff66'}; border-radius: 4px;"
        )
        self.info_lbl.setText(
            f"{status_line}\n"
            f"Clamp Chord: {chord:.0f} mm | Elec Arch: {arch_h:.0f} mm | Slack: {elec_len - chord:.0f} mm\n"
            f"Yaw L/R: {lengths[0]:.0f}/{lengths[1]:.0f} mm | Pitch Top: {lengths[2]:.0f}/{lengths[3]:.0f} mm"
        )

    def on_slider_change(self):
        self.update_pose(self.yaw_slider.value(), self.pitch_slider.value(), self.roll_slider.value())

    def on_play_toggled(self, checked):
        if checked:
            self.play_btn.setText("Pause Sweep")
            self.timer.start(35)
        else:
            self.play_btn.setText("Play Sweep (±60°)")
            self.timer.stop()

    def on_reset(self):
        self.play_btn.setChecked(False)
        self.yaw_slider.setValue(0)
        self.pitch_slider.setValue(0)
        self.roll_slider.setValue(0)

    def on_timer(self):
        t = self.step * 0.06
        yaw = int(round(60.0 * math.sin(t)))
        pitch = int(round(15.0 * math.sin(t * 2.0)))
        roll = int(round(15.0 * math.cos(t)))

        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(True)
        self.yaw_slider.setValue(yaw)
        self.pitch_slider.setValue(pitch)
        self.roll_slider.setValue(roll)
        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(False)

        self.update_pose(yaw, pitch, roll)
        self.step += 1

    def closeEvent(self, event):
        self.timer.stop()
        super().closeEvent(event)

for w in QtWidgets.QApplication.topLevelWidgets():
    if w.objectName() == "AGV_Cable_Sim_Dialog":
        w.close()

dlg = CableSimDialog(Gui.getMainWindow())
dlg.setObjectName("AGV_Cable_Sim_Dialog")
dlg.show()
Gui.SendMsgToActiveView("ViewFit")
