import FreeCAD as App
import FreeCADGui as Gui
import Part
import math

try:
    from PySide6 import QtCore, QtWidgets
    Qt = QtCore.Qt
except ImportError:
    from PySide2 import QtCore, QtWidgets
    Qt = QtCore.Qt

# --- PARAMETRIC DIMENSIONS (mm) ---
TRAILER_WIDTH = 500.0       # Width of AGV rear & trailer front reference plates
PLATE_THICK = 10.0
DRAWBAR_LEN = 350.0         # Length from each vehicle body to the ball joint center
DRAWBAR_DIA = 50.0          # 50mm round drawbar tube
BALL_DIA = 55.0             # Central ball joint sphere

# Electrical Hybrid Jumper Cable (Option 2: 45-deg Angled Clamps + Bend-Relief Boots)
CLAMP_OFFSET = 200.0        # Distance from ball joint center to each electrical clamp
CLAMP_HEIGHT = 34.0         # Clamp pivot height above drawbar center
BOOT_LEN = 65.0             # Stiff 65mm bend-relief boot / spring sleeve length
CABLE_DIA = 10.0            # 10mm OD hybrid robotic cable

# 3mm Steel Pull-Pull Control Cables (4-Corner Diagonal Layout)
STEEL_CABLE_DIA = 3.0

doc = App.ActiveDocument or App.newDocument("AGV_Option2_Angled_Clamps")
for obj in doc.Objects:
    doc.removeObject(obj.Name)

# Create solid parts
agv_plate = doc.addObject("Part::Feature", "AGV_Rear_Plate")
agv_plate.ViewObject.ShapeColor = (0.20, 0.35, 0.55)
agv_plate.ViewObject.Transparency = 55

agv_bar = doc.addObject("Part::Feature", "AGV_Drawbar_50mm")
agv_bar.Shape = Part.makeCylinder(DRAWBAR_DIA/2, DRAWBAR_LEN, App.Vector(-DRAWBAR_LEN, 0, 0), App.Vector(1, 0, 0))
agv_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

ball_joint = doc.addObject("Part::Feature", "Ball_Joint")
ball_joint.Shape = Part.makeSphere(BALL_DIA/2, App.Vector(0, 0, 0))
ball_joint.ViewObject.ShapeColor = (0.85, 0.55, 0.15)

# Angled Clamp Saddles & Stiff Bend-Relief Boots (Option 2)
clamp_agv = doc.addObject("Part::Feature", "Clamp_AGV_Angled")
clamp_agv.ViewObject.ShapeColor = (0.15, 0.15, 0.15)

boot_agv = doc.addObject("Part::Feature", "BendRelief_Boot_AGV")
boot_agv.ViewObject.ShapeColor = (0.22, 0.24, 0.28)

# Trailer group (rotates around ball joint at 0,0,0)
trailer_bar = doc.addObject("Part::Feature", "Trailer_Drawbar_50mm")
trailer_bar.Shape = Part.makeCylinder(DRAWBAR_DIA/2, DRAWBAR_LEN, App.Vector(0, 0, 0), App.Vector(1, 0, 0))
trailer_bar.ViewObject.ShapeColor = (0.35, 0.38, 0.42)

trailer_plate = doc.addObject("Part::Feature", "Trailer_Front_Plate")
trailer_plate.ViewObject.ShapeColor = (0.25, 0.55, 0.35)
trailer_plate.ViewObject.Transparency = 55

clamp_trl = doc.addObject("Part::Feature", "Clamp_Trailer_Angled")
clamp_trl.ViewObject.ShapeColor = (0.15, 0.15, 0.15)

boot_trl = doc.addObject("Part::Feature", "BendRelief_Boot_Trailer")
boot_trl.ViewObject.ShapeColor = (0.22, 0.24, 0.28)

# Electrical loop object
elec_cable_obj = doc.addObject("Part::Feature", "Elec_Jumper_10mm")
elec_cable_obj.ViewObject.ShapeColor = (0.95, 0.45, 0.10)

# 4 Corner Pull-Pull Steel Cables
corner_names = ["Corner_Top_Left", "Corner_Top_Right", "Corner_Bot_Left", "Corner_Bot_Right"]
base_colors = [
    (0.85, 0.20, 0.20),  # Top-Left (Red)
    (0.85, 0.20, 0.20),  # Top-Right (Red)
    (0.15, 0.70, 0.85),  # Bot-Left (Cyan)
    (0.15, 0.70, 0.85),  # Bot-Right (Cyan)
]
steel_objs = []
for name, col in zip(corner_names, base_colors):
    obj = doc.addObject("Part::Feature", name)
    obj.ViewObject.ShapeColor = col
    steel_objs.append(obj)

def make_angled_clamp_and_boot(base_pt, dir_vec):
    d = App.Vector(dir_vec).normalize()
    # Saddle block at clamp base
    saddle = Part.makeCylinder(13, 28, base_pt - d * 14.0, d)
    # Tapered stiff bend-relief boot extending BOOT_LEN along launch vector
    boot = Part.makeCone(9.5, 6.8, BOOT_LEN, base_pt + d * 14.0, d)
    return saddle, boot

def build_elec_cable_shape(p0, t0, p1, t1, target_len, radius):
    # p0, p1 are the tips of the stiff bend-relief boots; t0, t1 are the angled launch tangents
    chord = p0.distanceToPoint(p1)
    effective_len = max(target_len, chord + 15.0)
    up = App.Vector(0, 0, 1)

    low, high = 5.0, 350.0
    best_wire = None
    best_apex_z = 0.0
    for _ in range(20):
        mid = 0.5 * (low + high)
        c1 = p0 + t0 * (mid * 0.55)
        c2 = p1 + t1 * (mid * 0.55)
        apex = (p0 + p1) * 0.5 + up * (mid * 0.65)
        bs = Part.BSplineCurve()
        bs.buildFromPoles([p0, c1, apex, c2, p1])
        wire = Part.Wire(bs.toShape())
        if wire.Length < effective_len:
            low = mid
        else:
            high = mid
        best_wire = wire
        best_apex_z = apex.z

    profile = Part.Wire(Part.makeCircle(radius, p0, t0))
    return best_wire.makePipeShell([profile], True, True), best_apex_z

def build_taut_cable_shape(p0, p1, radius):
    edge = Part.makeLine(p0, p1)
    wire = Part.Wire(edge)
    tangent = (p1 - p0).normalize()
    profile = Part.Wire(Part.makeCircle(radius, p0, tangent))
    return wire.makePipeShell([profile], True, True), wire.Length

class CableSimDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("AGV Option 2: 45° Bend-Relief Clamps & 4-Corner Tendons")
        self.setWindowFlags(self.windowFlags() | Qt.WindowStaysOnTopHint)
        self.resize(420, 410)

        layout = QtWidgets.QVBoxLayout(self)

        self.yaw_slider, self.yaw_lbl = self._make_slider(layout, "Yaw (Turn):", -90, 90, 0, "°")
        self.pitch_slider, self.pitch_lbl = self._make_slider(layout, "Pitch (Hill):", -30, 30, 0, "°")
        self.roll_slider, self.roll_lbl = self._make_slider(layout, "Roll (Tilt):", -30, 30, 0, "°")
        self.clamp_ang_slider, self.clamp_ang_lbl = self._make_slider(layout, "Clamp Launch:", 0, 60, 45, "°")
        self.len_slider, self.len_lbl = self._make_slider(layout, "Free Loop Len:", 300, 520, 380, " mm")
        self.cy_slider, self.cy_lbl = self._make_slider(layout, "Corner ±Y Dist:", 60, 250, 240, " mm")
        self.cz_slider, self.cz_lbl = self._make_slider(layout, "Corner ±Z Dist:", 50, 220, 135, " mm")

        self.info_lbl = QtWidgets.QLabel()
        self.info_lbl.setStyleSheet("font-weight: bold; padding: 8px; background: #222; color: #0f0; border-radius: 4px;")
        layout.addWidget(self.info_lbl)

        btn_row = QtWidgets.QHBoxLayout()
        self.play_btn = QtWidgets.QPushButton("Play Sweep (±60°)")
        self.play_btn.setCheckable(True)
        self.reset_btn = QtWidgets.QPushButton("Reset (0°)")
        btn_row.addWidget(self.play_btn)
        btn_row.addWidget(self.reset_btn)
        layout.addLayout(btn_row)

        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider,
                  self.clamp_ang_slider, self.len_slider, self.cy_slider, self.cz_slider):
            s.valueChanged.connect(self.on_slider_change)

        self.play_btn.toggled.connect(self.on_play_toggled)
        self.reset_btn.clicked.connect(self.on_reset)

        self.step = 0
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.on_timer)

        self.update_pose()

    def _make_slider(self, parent_layout, title, min_v, max_v, init_v, unit):
        row = QtWidgets.QHBoxLayout()
        lbl = QtWidgets.QLabel(f"{title} {init_v}{unit}")
        lbl.setFixedWidth(135)
        slider = QtWidgets.QSlider(Qt.Horizontal)
        slider.setRange(min_v, max_v)
        slider.setValue(init_v)
        row.addWidget(lbl)
        row.addWidget(slider)
        parent_layout.addLayout(row)
        return slider, lbl

    def update_pose(self):
        yaw_deg = self.yaw_slider.value()
        pitch_deg = self.pitch_slider.value()
        roll_deg = self.roll_slider.value()
        launch_deg = self.clamp_ang_slider.value()
        free_len = float(self.len_slider.value())
        cy = float(self.cy_slider.value())
        cz = float(self.cz_slider.value())

        self.yaw_lbl.setText(f"Yaw (Turn): {yaw_deg}°")
        self.pitch_lbl.setText(f"Pitch (Hill): {pitch_deg}°")
        self.roll_lbl.setText(f"Roll (Tilt): {roll_deg}°")
        self.clamp_ang_lbl.setText(f"Clamp Launch: {launch_deg}°")
        self.len_lbl.setText(f"Free Loop Len: {int(free_len)} mm")
        self.cy_lbl.setText(f"Corner ±Y Dist: {int(cy)} mm")
        self.cz_lbl.setText(f"Corner ±Z Dist: {int(cz)} mm")

        plate_h = max(260.0, cz * 2.0 + 40.0)
        agv_plate.Shape = Part.makeBox(PLATE_THICK, TRAILER_WIDTH, plate_h, App.Vector(-DRAWBAR_LEN - PLATE_THICK, -TRAILER_WIDTH/2, -plate_h/2))
        trailer_plate.Shape = Part.makeBox(PLATE_THICK, TRAILER_WIDTH, plate_h, App.Vector(DRAWBAR_LEN, -TRAILER_WIDTH/2, -plate_h/2))

        rot = App.Rotation(yaw_deg, pitch_deg, roll_deg)
        placement = App.Placement(App.Vector(0, 0, 0), rot)
        trailer_bar.Placement = placement
        trailer_plate.Placement = placement

        # Option 2: 45-deg Angled Clamps & Stiff Bend-Relief Boots
        rad = math.radians(launch_deg)
        agv_base = App.Vector(-CLAMP_OFFSET, 0, CLAMP_HEIGHT)
        agv_dir = App.Vector(math.cos(rad), 0, math.sin(rad))
        s_agv, b_agv = make_angled_clamp_and_boot(agv_base, agv_dir)
        clamp_agv.Shape = s_agv
        boot_agv.Shape = b_agv

        trl_base_local = App.Vector(CLAMP_OFFSET, 0, CLAMP_HEIGHT)
        trl_dir_local = App.Vector(-math.cos(rad), 0, math.sin(rad))
        s_trl, b_trl = make_angled_clamp_and_boot(trl_base_local, trl_dir_local)
        clamp_trl.Shape = s_trl
        boot_trl.Shape = b_trl
        clamp_trl.Placement = placement
        boot_trl.Placement = placement

        # Cable exits from the tips of the two stiff boots
        tip_offset = 14.0 + BOOT_LEN
        ep0 = agv_base + agv_dir * tip_offset
        et0 = agv_dir
        ep1 = placement.multVec(trl_base_local + trl_dir_local * tip_offset)
        et1 = rot.multVec(trl_dir_local)

        elec_shape, apex_z = build_elec_cable_shape(ep0, et0, ep1, et1, free_len, CABLE_DIA / 2.0)
        elec_cable_obj.Shape = elec_shape
        total_clamp_to_clamp = free_len + 2.0 * tip_offset

        # 4 Corner Pull-Pull Steel Cables
        anchors_local = [
            (App.Vector(-DRAWBAR_LEN,  cy,  cz), App.Vector(DRAWBAR_LEN,  cy,  cz)),  # Top-Left
            (App.Vector(-DRAWBAR_LEN, -cy,  cz), App.Vector(DRAWBAR_LEN, -cy,  cz)),  # Top-Right
            (App.Vector(-DRAWBAR_LEN,  cy, -cz), App.Vector(DRAWBAR_LEN,  cy, -cz)),  # Bot-Left
            (App.Vector(-DRAWBAR_LEN, -cy, -cz), App.Vector(DRAWBAR_LEN, -cy, -cz)),  # Bot-Right
        ]

        lengths = []
        clash_names = []
        min_overall_gap = 9999.0
        obstacles = [agv_bar.Shape, trailer_bar.Shape, ball_joint.Shape,
                     clamp_agv.Shape, clamp_trl.Shape, boot_agv.Shape, boot_trl.Shape,
                     elec_cable_obj.Shape]

        for idx, (a0, a1_local) in enumerate(anchors_local):
            p0 = a0
            p1 = placement.multVec(a1_local)
            shape, c_len = build_taut_cable_shape(p0, p1, STEEL_CABLE_DIA / 2.0)
            steel_objs[idx].Shape = shape
            lengths.append(c_len)

            dist_res = [shape.distToShape(obs)[0] for obs in obstacles]
            min_dist = min(dist_res)
            if min_dist < min_overall_gap:
                min_overall_gap = min_dist

            if min_dist < 1.0:
                steel_objs[idx].ViewObject.ShapeColor = (1.0, 0.85, 0.0)
                clash_names.append(corner_names[idx])
            else:
                steel_objs[idx].ViewObject.ShapeColor = base_colors[idx]

        doc.recompute()

        if clash_names:
            status_line = f"WARNING - Clash: {', '.join(clash_names)}"
            color_hex = "#ff4444"
        else:
            status_line = f"Clearance OK (Min gap: {min_overall_gap:.1f} mm)"
            color_hex = "#00ff66"

        self.info_lbl.setStyleSheet(
            f"font-weight: bold; padding: 8px; background: #222; color: {color_hex}; border-radius: 4px;"
        )
        self.info_lbl.setText(
            f"{status_line}
"
            f"Loop Apex Z: {apex_z:.0f} mm | Total Clamp-to-Clamp Cable: {total_clamp_to_clamp:.0f} mm
"
            f"Top L/R: {lengths[0]:.0f} / {lengths[1]:.0f} mm | Bot L/R: {lengths[2]:.0f} / {lengths[3]:.0f} mm"
        )

    def on_slider_change(self):
        self.update_pose()

    def on_play_toggled(self, checked):
        if checked:
            self.play_btn.setText("Pause Sweep")
            self.timer.start(35)
        else:
            self.play_btn.setText("Play Sweep (±60°)")
            self.timer.stop()

    def on_reset(self):
        self.play_btn.setChecked(False)
        self.yaw_slider.setValue(0)
        self.pitch_slider.setValue(0)
        self.roll_slider.setValue(0)

    def on_timer(self):
        t = self.step * 0.06
        yaw = int(round(60.0 * math.sin(t)))
        pitch = int(round(15.0 * math.sin(t * 2.0)))
        roll = int(round(15.0 * math.cos(t)))

        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(True)
        self.yaw_slider.setValue(yaw)
        self.pitch_slider.setValue(pitch)
        self.roll_slider.setValue(roll)
        for s in (self.yaw_slider, self.pitch_slider, self.roll_slider):
            s.blockSignals(False)

        self.update_pose()
        self.step += 1

    def closeEvent(self, event):
        self.timer.stop()
        super().closeEvent(event)

for w in QtWidgets.QApplication.topLevelWidgets():
    if w.objectName() == "AGV_Cable_Sim_Dialog":
        w.close()

dlg = CableSimDialog(Gui.getMainWindow())
dlg.setObjectName("AGV_Cable_Sim_Dialog")
dlg.show()
Gui.SendMsgToActiveView("ViewFit")
