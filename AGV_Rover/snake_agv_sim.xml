<mujoco model="agv_3trailer_snake_v8">
	<option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
	<visual>
		<global offwidth="1280" offheight="720"/>
		<rgba haze="0.15 0.25 0.35 1"/>
	</visual>
	<asset>
		<texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.15 0.2" width="512" height="512"/>
		<texture name="grid" type="2d" builtin="checker" rgb1="0.28 0.36 0.22" rgb2="0.33 0.42 0.26" width="512" height="512"/>
		<material name="paddock" texture="grid" texrepeat="20 20" reflectance="0.1"/>
		<material name="chassis_lead" rgba="0.20 0.40 0.65 1"/>
		<material name="chassis_trl" rgba="0.25 0.55 0.35 1"/>
		<material name="drawbar" rgba="0.35 0.35 0.38 1"/>
		<material name="tire" rgba="0.12 0.12 0.14 1"/>
		<material name="cable_mat" rgba="0.90 0.25 0.15 1"/>
	</asset>
	<worldbody>
		<light pos="0 0 8" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
		<geom name="ground" type="plane" size="50 50 0.1" material="paddock" friction="0.85 0.005 0.0005"/>
		<!-- Simulated Paddock Ruts / Bumps -->
		<geom name="rut_1" type="box" pos="2.2 0.30 0.025" size="0.35 0.25 0.025" euler="0 5 0" material="paddock"/>
		<geom name="rut_2" type="box" pos="3.6 -0.30 0.030" size="0.40 0.25 0.030" euler="0 -6 0" material="paddock"/>
		<geom name="rut_3" type="box" pos="5.0 0.28 0.028" size="0.35 0.25 0.028" euler="4 0 0" material="paddock"/>
		<!-- ================= TRAILER 1 (LEAD POWERED AGV) ================= -->
		<body name="trailer_1" pos="0 0 0.32">
			<freejoint name="root_jnt"/>
			<geom name="t1_chassis" type="box" size="0.45 0.25 0.12" mass="110" material="chassis_lead"/>
			<!-- Wheels T1 -->
			<body name="t1_l" pos="0 0.32 -0.14">
				<joint name="j_t1_l" type="hinge" axis="0 1 0"/>
				<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
			</body>
			<body name="t1_r" pos="0 -0.32 -0.14">
				<joint name="j_t1_r" type="hinge" axis="0 1 0"/>
				<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
			</body>
			<!-- Drawbar T1 (Chassis rear -0.45 to Ball Joint -0.80) -->
			<geom name="t1_drawbar_rear" type="capsule" fromto="-0.45 0 0 -0.80 0 0" size="0.025" material="drawbar"/>
			<!-- Junction T1 Sites (j_t1_fxy) -->
			<site name="j_t1_ftl" pos="-0.45  0.24  0.165" size="0.015"/>
			<site name="j_t1_ftr" pos="-0.45 -0.24  0.165" size="0.015"/>
			<site name="j_t1_fbl" pos="-0.45  0.24 -0.165" size="0.015"/>
			<site name="j_t1_fbr" pos="-0.45 -0.24 -0.165" size="0.015"/>
			<!-- ================= TRAILER 2 (CENTER TRAILER) ================= -->
			<body name="trailer_2" pos="-1.60 0 0">
				<!-- Ball Joint at +0.80 relative to T2 (matches -0.80 relative to T1) -->
				<joint name="ball_joint_1" type="ball" pos="0.80 0 0" damping="12"/>
				<geom name="hitch_1_ball" type="sphere" pos="0.80 0 0" size="0.032" material="cable_mat"/>
				<!-- Drawbar T2 Front (Ball Joint +0.80 to Chassis front +0.45) -->
				<geom name="t2_drawbar_front" type="capsule" fromto="0.80 0 0 0.45 0 0" size="0.025" material="drawbar"/>
				<geom name="t2_chassis" type="box" size="0.45 0.25 0.12" mass="100" material="chassis_trl"/>
				<!-- Junction T2 Front Sites (j_t2_bxy - connects to j_t1_fxy) -->
				<site name="j_t2_btl" pos="0.45  0.24  0.165" size="0.015"/>
				<site name="j_t2_btr" pos="0.45 -0.24  0.165" size="0.015"/>
				<site name="j_t2_bbl" pos="0.45  0.24 -0.165" size="0.015"/>
				<site name="j_t2_bbr" pos="0.45 -0.24 -0.165" size="0.015"/>
				<!-- Wheels T2 -->
				<body name="t2_l" pos="0 0.32 -0.14">
					<joint name="j_t2_l" type="hinge" axis="0 1 0"/>
					<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
				</body>
				<body name="t2_r" pos="0 -0.32 -0.14">
					<joint name="j_t2_r" type="hinge" axis="0 1 0"/>
					<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
				</body>
				<!-- Drawbar T2 Rear (Chassis rear -0.45 to Ball Joint -0.80) -->
				<geom name="t2_drawbar_rear" type="capsule" fromto="-0.45 0 0 -0.80 0 0" size="0.025" material="drawbar"/>
				<!-- Junction T2 Rear Sites (j_t2_fxy) -->
				<site name="j_t2_ftl" pos="-0.45  0.24  0.165" size="0.015"/>
				<site name="j_t2_ftr" pos="-0.45 -0.24  0.165" size="0.015"/>
				<site name="j_t2_fbl" pos="-0.45  0.24 -0.165" size="0.015"/>
				<site name="j_t2_fbr" pos="-0.45 -0.24 -0.165" size="0.015"/>
				<!-- ================= TRAILER 3 (REAR TRAILER) ================= -->
				<body name="trailer_3" pos="-1.60 0 0">
					<!-- Ball Joint at +0.80 relative to T3 -->
					<joint name="ball_joint_2" type="ball" pos="0.80 0 0" damping="12"/>
					<geom name="hitch_2_ball" type="sphere" pos="0.80 0 0" size="0.032" material="cable_mat"/>
					<!-- Drawbar T3 Front (Ball Joint +0.80 to Chassis front +0.45) -->
					<geom name="t3_drawbar_front" type="capsule" fromto="0.80 0 0 0.45 0 0" size="0.025" material="drawbar"/>
					<geom name="t3_chassis" type="box" size="0.45 0.25 0.12" mass="100" material="chassis_lead"/>
					<!-- Junction T3 Front Sites (j_t3_bxy - connects to j_t2_fxy) -->
					<site name="j_t3_btl" pos="0.45  0.24  0.165" size="0.015"/>
					<site name="j_t3_btr" pos="0.45 -0.24  0.165" size="0.015"/>
					<site name="j_t3_bbl" pos="0.45  0.24 -0.165" size="0.015"/>
					<site name="j_t3_bbr" pos="0.45 -0.24 -0.165" size="0.015"/>
					<!-- Wheels T3 -->
					<body name="t3_l" pos="0 0.32 -0.14">
						<joint name="j_t3_l" type="hinge" axis="0 1 0"/>
						<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
					</body>
					<body name="t3_r" pos="0 -0.32 -0.14">
						<joint name="j_t3_r" type="hinge" axis="0 1 0"/>
						<geom type="cylinder" size="0.18 0.05" euler="90 0 0" mass="8" material="tire"/>
					</body>
				</body>
			</body>
		</body>
	</worldbody>
	<!-- 8 Spatial Tendons (4 per Ball Joint) with Inline Die-Spring Stiffness (150 N/mm) -->
	<tendon>
		<!-- Pull-Pull Cables: Trailer 1 to Trailer 2 (t1_t2_xy) -->
		<spatial name="t1_t2_tl" width="0.005" damping="200" material="cable_mat">
			<site site="j_t1_ftl"/>
			<site site="j_t2_btl"/>
		</spatial>
		<spatial name="t1_t2_tr" width="0.005" damping="200" material="cable_mat">
			<site site="j_t1_ftr"/>
			<site site="j_t2_btr"/>
		</spatial>
		<spatial name="t1_t2_bl" width="0.005" damping="200" material="cable_mat">
			<site site="j_t1_fbl"/>
			<site site="j_t2_bbl"/>
		</spatial>
		<spatial name="t1_t2_br" width="0.005" damping="200" material="cable_mat">
			<site site="j_t1_fbr"/>
			<site site="j_t2_bbr"/>
		</spatial>

		<!-- Pull-Pull Cables: Trailer 2 to Trailer 3 (t2_t3_xy) -->
		<spatial name="t2_t3_tl" width="0.005" damping="200" material="cable_mat">
			<site site="j_t2_ftl"/>
			<site site="j_t3_btl"/>
		</spatial>
		<spatial name="t2_t3_tr" width="0.005" damping="200" material="cable_mat">
			<site site="j_t2_ftr"/>
			<site site="j_t3_btr"/>
		</spatial>
		<spatial name="t2_t3_bl" width="0.005" damping="200" material="cable_mat">
			<site site="j_t2_fbl"/>
			<site site="j_t3_bbl"/>
		</spatial>
		<spatial name="t2_t3_br" width="0.005" damping="200" material="cable_mat">
			<site site="j_t2_fbr"/>
			<site site="j_t3_bbr"/>
		</spatial>
	</tendon>

	<actuator>
		<!-- Standard Wheel Velocity Drives (6 wheels across 3 single-axle segments) -->
		<velocity name="m_t1_l" joint="j_t1_l" kv="45"/>
		<velocity name="m_t1_r" joint="j_t1_r" kv="45"/>
		<velocity name="m_t2_l" joint="j_t2_l" kv="35"/>
		<velocity name="m_t2_r" joint="j_t2_r" kv="35"/>
		<velocity name="m_t3_l" joint="j_t3_l" kv="35"/>
		<velocity name="m_t3_r" joint="j_t3_r" kv="35"/>

		<!-- Capstan Position Actuators (Pull-only via force range [-6000, 0] N) -->
		<position name="cap_t1_t2_tl" tendon="t1_t2_tl" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t1_t2_tr" tendon="t1_t2_tr" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t1_t2_bl" tendon="t1_t2_bl" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t1_t2_br" tendon="t1_t2_br" kp="20000" kv="500" forcerange="-6000 0"/>

		<position name="cap_t2_t3_tl" tendon="t2_t3_tl" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t2_t3_tr" tendon="t2_t3_tr" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t2_t3_bl" tendon="t2_t3_bl" kp="20000" kv="500" forcerange="-6000 0"/>
		<position name="cap_t2_t3_br" tendon="t2_t3_br" kp="20000" kv="500" forcerange="-6000 0"/>
	</actuator>
</mujoco>
