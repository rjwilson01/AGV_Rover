import FreeCAD as App
import Part
import math

# Create the Master Assembly Document
doc = App.newDocument("CNC_Master_Assembly")

# =============================================================================
# GLOBAL SYSTEM PARAMETERS (Must match individual component scripts)
# =============================================================================
plate_w = 200.0
plate_l = 200.0
plate_h = 55.0  

tslot_count = 5
tslot_spacing = plate_w / (tslot_count - 1) 
tslot_w1, tslot_h1, tslot_w2, tslot_h2 = 25.0, 10.0, 14.0, 14.0
tslot_depth = tslot_h1 + tslot_h2
steel_thick = 4.0
bottom_proud = 3.0

pillar_w = 120.0    
pillar_l = 250.0    
pillar_h = 400.0    
clearance_gap = 280.0 
pillar_offset_x = (clearance_gap / 2) + (pillar_w / 2)

bridge_seat_depth = 40.0
bridge_seat_height = 80.0
bridge_w = clearance_gap + (bridge_seat_depth * 2)

base_w = 600.0      
base_l = 400.0      
base_h = 80.0       
rail_span_x = 120.0
rail_bed_w, rail_bed_h = 30.0, 5.0
drain_w, drain_depth = 60.0, 15.0

# =============================================================================
# 1. GENERATE MASTER BASE
# =============================================================================
base_box = Part.makeBox(base_w, base_l, base_h)
base_box.translate(App.Vector(-base_w/2, -base_l/2, -base_h))
base_shape = base_box

drain_left = Part.makeBox(drain_w, base_l + 10, drain_depth)
drain_left.translate(App.Vector(-rail_span_x/2 - drain_w - 10, -(base_l+10)/2, -drain_depth))
base_shape = base_shape.cut(drain_left)

drain_center = Part.makeBox(rail_span_x - rail_bed_w, base_l + 10, drain_depth - 2)
drain_center.translate(App.Vector(-(rail_span_x - rail_bed_w)/2, -(base_l+10)/2, -drain_depth + 2))
base_shape = base_shape.cut(drain_center)

drain_right = Part.makeBox(drain_w, base_l + 10, drain_depth)
drain_right.translate(App.Vector(rail_span_x/2 + 10, -(base_l+10)/2, -drain_depth))
base_shape = base_shape.cut(drain_right)

gantry_bolt_r = 7.0 
left_pillar_center_x = -(clearance_gap / 2 + pillar_w / 2)
right_pillar_center_x = (clearance_gap / 2 + pillar_w / 2)
for b_y in [-80.0, 0.0, 80.0]:
    for b_x in [-35.0, 35.0]:
        b_hole_l = Part.makeCylinder(gantry_bolt_r, base_h + 10)
        b_hole_l.translate(App.Vector(left_pillar_center_x + b_x, b_y, -base_h - 5))
        base_shape = base_shape.cut(b_hole_l)
        b_hole_r = Part.makeCylinder(gantry_bolt_r, base_h + 10)
        b_hole_r.translate(App.Vector(right_pillar_center_x + b_x, b_y, -base_h - 5))
        base_shape = base_shape.cut(b_hole_r)

base_obj = doc.addObject("Part::Feature", "A_Machine_Base")
base_obj.Shape = base_shape
base_obj.ViewObject.ShapeColor = (0.15, 0.15, 0.15)

# =============================================================================
# 2. GENERATE AND POSITION PILLARS (Sitting on top of Base)
# =============================================================================
# Left Pillar
left_box = Part.makeBox(pillar_w, pillar_l, pillar_h)
left_box.translate(App.Vector(-pillar_w/2, -pillar_l/2, 0))
step_cut_l = Part.makeBox(bridge_seat_depth + 5, pillar_l + 10, bridge_seat_height + 5)
step_cut_l.translate(App.Vector(-pillar_w/2 - 1, -pillar_l/2 - 5, pillar_h - bridge_seat_height))
left_pillar_shape = left_box.cut(step_cut_l)
left_pillar_shape.translate(App.Vector(-pillar_offset_x, 0, 0)) # Sits at Z=0 on base surface

left_obj = doc.addObject("Part::Feature", "B_Gantry_Pillar_Left")
left_obj.Shape = left_pillar_shape
left_obj.ViewObject.ShapeColor = (0.28, 0.28, 0.3)

# Right Pillar
right_box = Part.makeBox(pillar_w, pillar_l, pillar_h)
right_box.translate(App.Vector(-pillar_w/2, -pillar_l/2, 0))
step_cut_r = Part.makeBox(bridge_seat_depth + 5, pillar_l + 10, bridge_seat_height + 5)
step_cut_r.translate(App.Vector(pillar_w/2 - bridge_seat_depth, -pillar_l/2 - 5, pillar_h - bridge_seat_height))
right_pillar_shape = right_box.cut(step_cut_r)
right_pillar_shape.translate(App.Vector(pillar_offset_x, 0, 0))

right_obj = doc.addObject("Part::Feature", "B_Gantry_Pillar_Right")
right_obj.Shape = right_pillar_shape
right_obj.ViewObject.ShapeColor = (0.28, 0.28, 0.3)

# =============================================================================
# 3. GENERATE AND POSITION GANTRY BRIDGE (Seated inside pillar steps)
# =============================================================================
bridge_box = Part.makeBox(bridge_w, bridge_l, bridge_h)
bridge_box.translate(App.Vector(-bridge_w/2, -bridge_l/2, 0))
bridge_shape = bridge_box
for x_pos in [-(clearance_gap/2 + bridge_seat_depth/2), (clearance_gap/2 + bridge_seat_depth/2)]:
    for y_pos in [-bridge_l/2 + 60.0, bridge_l/2 - 60.0]:
        bolt_tube = Part.makeCylinder(gantry_bolt_r, bridge_seat_height + 10)
        bolt_tube.translate(App.Vector(x_pos, y_pos, -5))
        bridge_shape = bridge_shape.cut(bolt_tube)
# Position exactly on the pillar shoulder step
bridge_shape.translate(App.Vector(0, 0, pillar_h - bridge_seat_height))

bridge_obj = doc.addObject("Part::Feature", "C_Gantry_Bridge")
bridge_obj.Shape = bridge_shape
bridge_obj.ViewObject.ShapeColor = (0.33, 0.33, 0.35)

# =============================================================================
# 4. GENERATE AND POSITION MOVING Y-TABLE (Hovering at operational height)
# =============================================================================
base_box_y = Part.makeBox(plate_w, plate_l, plate_h)
base_box_y.translate(App.Vector(-plate_w/2, -plate_l/2, -plate_h))
eg_shape = base_box_y

for i in range(tslot_count):
    x_pos = -plate_w/2 + (i * tslot_spacing)
    b1 = Part.makeBox(tslot_w1, plate_l, tslot_h1)
    b1.translate(App.Vector(-tslot_w1/2, -plate_l/2, -tslot_depth))
    b2 = Part.makeBox(tslot_w2, plate_l, tslot_h2)
    b2.translate(App.Vector(-tslot_w2/2, -plate_l/2, -tslot_h2))
    tslot_single = b1.fuse(b2)
    tslot_single.translate(App.Vector(x_pos, 0, 0))
    eg_shape = eg_shape.cut(tslot_single)

bearing_bolt_xs = [-(120.0/2 + 50.0/2), -(120.0/2 - 50.0/2), (120.0/2 - 50.0/2), (120.0/2 + 50.0/2)]
bearing_bolt_ys = [-100.0/2 - 40.0/2, -100.0/2 + 40.0/2, 100.0/2 - 40.0/2, 100.0/2 + 40.0/2]
for x_pos in bearing_bolt_xs:
    for y_pos in bearing_bolt_ys:
        tube = Part.makeCylinder(3.5, plate_h + 10)
        tube.translate(App.Vector(x_pos, y_pos, -plate_h - 5))
        eg_shape = eg_shape.cut(tube)

# Translate Y-Table up to operational spacing height (Assuming 25mm Rail height + Block spacing)
# Top face rests slightly below the Z-axis workspace field
eg_shape.translate(App.Vector(0, 0, 45.0))

y_table_obj = doc.addObject("Part::Feature", "D_Moving_Y_Table")
y_table_obj.Shape = eg_shape
y_table_obj.ViewObject.ShapeColor = (0.5, 0.5, 0.5)

# =============================================================================
# 5. GENERATE AND POSITION Z-AXIS CARRIAGE (Centered inside gantry window)
# =============================================================================
z_plate_w, z_plate_l, z_plate_h = 180.0, 350.0, 45.0
z_box = Part.makeBox(z_plate_w, z_plate_l, z_plate_h)
z_box.translate(App.Vector(-z_plate_w/2, -z_plate_l/2, -z_plate_h))
z_shape = z_box

trench = Part.makeBox(55.0, z_plate_l + 10, 25.0)
trench.translate(App.Vector(-55.0/2, -(z_plate_l+10)/2, -25.0))
z_shape = z_shape.cut(trench)

for pos in [App.Vector(-60.0, -z_plate_l/4 - 30.0, 0), App.Vector(60.0, -z_plate_l/4 - 30.0, 0),
            App.Vector(-60.0, -z_plate_l/4 + 30.0, 0), App.Vector(60.0, -z_plate_l/4 + 30.0, 0)]:
    b_hole = Part.makeCylinder(5.5, z_plate_h + 10)
    b_hole.translate(App.Vector(pos.x, pos.y, -z_plate_h - 5))
    z_shape = z_shape.cut(b_hole)

# Translate Z-axis into structural cutting position nested between pillars
z_shape.translate(App.Vector(0, 0, 250.0))

z_obj = doc.addObject("Part::Feature", "E_Z_Axis_Spindle_Carriage")
z_obj.Shape = z_shape
z_obj.ViewObject.ShapeColor = (0.4, 0.5, 0.6)

doc.recompute()
