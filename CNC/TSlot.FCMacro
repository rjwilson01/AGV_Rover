import FreeCAD as App
import Part

doc = App.activeDocument() if App.activeDocument() else App.newDocument("M12_Steel_Track")

# M12 T-Slot Dimensions
tslot_w1, tslot_h1, tslot_w2, tslot_h2 = 25.0, 10.0, 14.0, 14.0
tslot_depth = tslot_h1 + tslot_h2
steel_thick = 4.0
plate_l = 200.0

# Build the solid steel rail body
t_base = Part.makeBox(tslot_w1 + (steel_thick*2), plate_l, tslot_h1 + steel_thick)
t_base.translate(App.Vector(-(tslot_w1 + (steel_thick*2))/2, -plate_l/2, -tslot_depth - steel_thick))
t_neck = Part.makeBox(tslot_w2 + (steel_thick*2), plate_l, tslot_h2)
t_neck.translate(App.Vector(-(tslot_w2 + (steel_thick*2))/2, -plate_l/2, -tslot_h2))
track_solid = t_base.fuse(t_neck)

# Cut out the internal T-slot cavity
t_void_b1 = Part.makeBox(tslot_w1, plate_l + 10, tslot_h1)
t_void_b1.translate(App.Vector(-tslot_w1/2, -(plate_l+10)/2, -tslot_depth))
t_void_b2 = Part.makeBox(tslot_w2, plate_l + 10, tslot_h2 + 2)
t_void_b2.translate(App.Vector(-tslot_w2/2, -(plate_l+10)/2, -tslot_h2))
track_final = track_solid.cut(t_void_b1.fuse(t_void_b2))

# Drill the countersunk holes down the track length
for y_pos in [-80.0, -40.0, 0.0, 40.0, 80.0]:
    cs_pocket = Part.makeCylinder(6.0, 5.0).translate(App.Vector(0, y_pos, -tslot_depth))
    screw_shank = Part.makeCylinder(3.3, 15.0).translate(App.Vector(0, y_pos, -tslot_depth - 10.0))
    track_final = track_final.cut(cs_pocket).cut(screw_shank)

# Output the single track part
track_obj = doc.addObject("Part::Feature", "M12_Track_Module")
track_obj.Shape = track_final
doc.recompute()
