
def Select(s,i):
	Gui.Selection.addSelection('EDI_with_parts','Body001',s.Name+'.Edge'+ str(i))

d=App.getDocument('EDI_with_parts')
Gui.Selection.clearSelection()
for s in d.Objects:
	if s.TypeId == 'Sketcher::SketchObject' :
		if s.Label =="HouseNewPowerRuns" : 
			i=0
			for g in s.Geometry:
				Select(s,i)
				i=i+1
