
<mujoco model="double_fork_back_to_back_heims">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag warmstart="enable"/>
  </option>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
    <scale jointlength="0.12" jointwidth="0.012" forcewidth="0.01"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.85 0.9 0.95" rgb2="0.2 0.3 0.4" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4" width="512" height="512" mark="edge" markrgb="0.8 0.8 0.8"/>
    <material name="grid_mat" texture="grid" texrepeat="4 4" texuniform="true" reflectance="0.2"/>
    <material name="steel" rgba="0.72 0.75 0.78 1" specular="0.8" shininess="0.6"/>
    <material name="brass" rgba="0.85 0.65 0.2 1" specular="0.8" shininess="0.6"/>
    <material name="fork_mat" rgba="0.25 0.28 0.32 1" specular="0.6"/>
    <material name="bar1_mat" rgba="0.2 0.45 0.7 1"/>
    <material name="bar2_mat" rgba="0.85 0.35 0.2 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid_mat" pos="0 0 -0.25"/>

    <!-- ==================== BASE PIVOT 1 (Left Anchor) ==================== -->
    <body name="anchor_1" pos="-0.6 0 0.2">
      <geom name="base1_block" type="box" size="0.035 0.035 0.035" material="steel"/>
      
      <!-- Base Pivot 1: Horizontal + Vertical sweep (or full 3D ball) -->
      <body name="bar1_outer" pos="0 0 0">
        <joint name="base_pivot_1" type="ball" damping="0.05"/>
        <geom name="bar1_cyl" type="capsule" fromto="0 0 0 0.30 0 0" size="0.016" material="bar1_mat"/>
        
        <!-- Variable Length Bar 1 -->
        <body name="bar1_inner" pos="0.30 0 0">
          <joint name="slide_1" type="slide" axis="1 0 0" range="-0.12 0.20" damping="2.0"/>
          <geom name="bar1_rod" type="capsule" fromto="-0.12 0 0 0.18 0 0" size="0.011" material="steel"/>
          
          <!-- ==================== CLEVIS FORK 1 (Horizontal Pin) ==================== -->
          <body name="fork_1" pos="0.18 0 0">
            <!-- Fork yoke and two ears (top & bottom ears so pin runs horizontally along Y) -->
            <geom name="fork1_base" type="box" pos="0.01 0 0" size="0.01 0.022 0.014" material="fork_mat"/>
            <geom name="fork1_ear_left" type="box" pos="0.035 0.016 0" size="0.022 0.004 0.014" material="fork_mat"/>
            <geom name="fork1_ear_right" type="box" pos="0.035 -0.016 0" size="0.022 0.004 0.014" material="fork_mat"/>
            <!-- Horizontal Clevis Pin along Y -->
            <geom name="pin_1_geom" type="cylinder" pos="0.042 0 0" euler="90 0 0" size="0.005 0.024" material="brass"/>

            <!-- ==================== HEIM JOINT 1 (On Horizontal Pin) ==================== -->
            <body name="heim_1_ball" pos="0.042 0 0">
              <!-- Primary rotation around Horizontal Pin (Y), plus +/- 15 deg spherical misalignment -->
              <joint name="pin_1_horiz" type="hinge" axis="0 1 0" range="-85 85" damping="0.01"/>
              <geom name="heim1_sphere" type="sphere" size="0.012" material="brass"/>
              
              <body name="heim_1_body" pos="0 0 0">
                <!-- +/- 15 deg spherical misalignment cone of Heim 1 -->
                <joint name="heim_1_cone" type="ball" range="0 15" damping="0.05"/>
                <geom name="heim1_eye" type="cylinder" euler="90 0 0" size="0.018 0.007" material="steel"/>
                <!-- Shank of Heim 1 extending along +X -->
                <geom name="heim1_shank" type="cylinder" fromto="0.018 0 0 0.045 0 0" size="0.006" material="steel"/>

                <!-- ==================== BACK-TO-BACK CENTER SWIVEL (180-360 deg Axial Roll) ==================== -->
                <body name="heim_2_body" pos="0.045 0 0">
                  <!-- Passive 360-degree axial roll between the two back-to-back Heim joints -->
                  <joint name="back_to_back_roll" type="hinge" axis="1 0 0" damping="0.005"/>
                  <!-- Shank of Heim 2 extending along +X -->
                  <geom name="heim2_shank" type="cylinder" fromto="0 0 0 0.027 0 0" size="0.006" material="steel"/>
                  <!-- Eye of Heim 2 oriented vertically (bore along Z for Vertical Clevis Pin) -->
                  <geom name="heim2_eye" type="cylinder" pos="0.045 0 0" euler="0 0 0" size="0.018 0.007" material="steel"/>

                  <!-- ==================== HEIM JOINT 2 (On Vertical Pin) ==================== -->
                  <body name="heim_2_ball" pos="0.045 0 0">
                    <!-- +/- 15 deg spherical misalignment cone of Heim 2 -->
                    <joint name="heim_2_cone" type="ball" range="0 15" damping="0.05"/>
                    <geom name="heim2_sphere" type="sphere" size="0.012" material="brass"/>

                    <!-- ==================== CLEVIS FORK 2 (Vertical Pin) ==================== -->
                    <body name="fork_2" pos="0 0 0">
                      <!-- Primary rotation around Vertical Pin (Z) -->
                      <joint name="pin_2_vert" type="hinge" axis="0 0 1" range="-85 85" damping="0.01"/>
                      <!-- Vertical Clevis Pin along Z -->
                      <geom name="pin_2_geom" type="cylinder" pos="0 0 0" size="0.005 0.024" material="brass"/>
                      <!-- Top & bottom fork ears -->
                      <geom name="fork2_ear_top" type="box" pos="0.007 0 0.016" size="0.022 0.014 0.004" material="fork_mat"/>
                      <geom name="fork2_ear_bot" type="box" pos="0.007 0 -0.016" size="0.022 0.014 0.004" material="fork_mat"/>
                      <geom name="fork2_base" type="box" pos="0.032 0 0" size="0.01 0.014 0.022" material="fork_mat"/>

                      <!-- ==================== VARIABLE LENGTH BAR 2 ==================== -->
                      <body name="bar2_outer" pos="0.042 0 0">
                        <geom name="bar2_cyl" type="capsule" fromto="0 0 0 0.30 0 0" size="0.016" material="bar2_mat"/>
                        
                        <body name="bar2_inner" pos="0.30 0 0">
                          <joint name="slide_2" type="slide" axis="1 0 0" range="-0.12 0.20" damping="2.0"/>
                          <geom name="bar2_rod" type="capsule" fromto="-0.12 0 0 0.18 0 0" size="0.011" material="steel"/>
                          
                          <site name="bar2_tip_site" pos="0.18 0 0" size="0.015" rgba="0 1 0 1"/>
                        </body>
                      </body>

                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ==================== BASE PIVOT 2 (Right Anchor) ==================== -->
    <body name="anchor_2" pos="0.65 0 0.2">
      <geom name="base2_block" type="box" size="0.035 0.035 0.035" material="steel"/>
      <site name="anchor2_site" pos="0 0 0" size="0.015" rgba="1 0 0 1"/>
    </body>
  </worldbody>

  <equality>
    <connect name="base_pivot_2" site1="bar2_tip_site" site2="anchor2_site" solref="0.005 1"/>
  </equality>

  <actuator>
    <position name="act_bar1_length" joint="slide_1" kp="2500" kv="60" ctrlrange="-0.12 0.20"/>
    <position name="act_bar2_length" joint="slide_2" kp="2500" kv="60" ctrlrange="-0.12 0.20"/>
  </actuator>
</mujoco>
