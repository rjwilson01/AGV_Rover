import FreeCAD as App
import Part
import math

# ==============================================================================
# PARAMETERS (Adjust dimensions in mm here)
# ==============================================================================
CUTAWAY = True              # True = quarter-section cutaway; False = full 3D solid

# 42mm CHS Housing (42.4mm OD standard pipe; 3.2mm wall -> 36.0mm ID)
CHS_OD = 42.4
CHS_WALL = 3.2
CHS_ID = CHS_OD - 2 * CHS_WALL
CHS_LENGTH = 85.0
BAFFLE_OFFSET_FROM_RIGHT = 28.0  # Distance from right open end to baffle center

# Internal Baffle Washer (Heavy M16 flat washer dressed to fit CHS_ID)
BAFFLE_OD = CHS_ID - 0.2
BAFFLE_ID = 17.0
BAFFLE_THICK = 4.0

# Radial PTFE/Bronze Split Bushing (16mm ID x 17mm OD x 10mm)
BUSHING_ID = 16.0
BUSHING_OD = 17.0
BUSHING_LEN = 10.0

# 51103 Thrust Ball Bearings (17mm ID x 30mm OD x 9mm thick)
BRG_ID = 17.0
BRG_OD = 30.0
BRG_THICK = 9.0
BRG_WASHER_THICK = 2.5
BALL_DIA = 4.0
NUM_BALLS = 14

# M16 Shaft & Fasteners
SHAFT_DIA = 16.0
SHAFT_LENGTH = 72.0
JAM_NUT_THICK = 8.0
NYLOC_THICK = 16.0
HEX_ACROSS_FLATS = 24.0     # Standard M16 hex width across flats

# Left End Removable Plug & Cross-Pin
PLUG_LEN = 22.0
CROSS_PIN_DIA = 10.0

# End Fittings (Clevis Forks)
CLEVIS_BODY_DIA = 26.0
CLEVIS_BODY_LEN = 22.0
CLEVIS_FORK_LEN = 32.0
CLEVIS_GAP = 14.0
CLEVIS_EAR_THICK = 6.0
CLEVIS_PIN_DIA = 12.0

# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================
def make_hex_prism(across_flats, height, bore_dia=0.0):
    """Creates a hexagonal prism along the X-axis starting at X=0."""
    radius = across_flats / math.sqrt(3.0)
    pts = []
    for i in range(6):
        angle = math.radians(60 * i + 30)
        pts.append(App.Vector(0, radius * math.cos(angle), radius * math.sin(angle)))
    pts.append(pts[0])
    wire = Part.makePolygon(pts)
    face = Part.Face(wire)
    solid = face.extrude(App.Vector(height, 0, 0))
    if bore_dia > 0:
        bore = Part.makeCylinder(bore_dia / 2.0, height + 2.0, App.Vector(-1, 0, 0), App.Vector(1, 0, 0))
        solid = solid.cut(bore)
    return solid

def make_clevis_fork(is_female=True):
    """Creates a clevis fork aligned along the X-axis, base at X=0, fork extending +X."""
    base = Part.makeCylinder(CLEVIS_BODY_DIA / 2.0, CLEVIS_BODY_LEN, App.Vector(0, 0, 0), App.Vector(1, 0, 0))
    if is_female:
        hole = Part.makeCylinder(SHAFT_DIA / 2.0, CLEVIS_BODY_LEN - 4.0, App.Vector(-1, 0, 0), App.Vector(1, 0, 0))
        base = base.cut(hole)

    fork_w = CLEVIS_GAP + 2 * CLEVIS_EAR_THICK
    fork_h = CLEVIS_BODY_DIA
    fork_box = Part.makeBox(CLEVIS_FORK_LEN, fork_w, fork_h,
                            App.Vector(CLEVIS_BODY_LEN - 2.0, -fork_w / 2.0, -fork_h / 2.0))
    tip_cyl = Part.makeCylinder(fork_h / 2.0, fork_w,
                                App.Vector(CLEVIS_BODY_LEN + CLEVIS_FORK_LEN - fork_h / 2.0, -fork_w / 2.0, 0),
                                App.Vector(0, 1, 0))
    trim_box = Part.makeBox(fork_h, fork_w + 2.0, fork_h + 2.0,
                            App.Vector(CLEVIS_BODY_LEN + CLEVIS_FORK_LEN - fork_h / 2.0, -fork_w / 2.0 - 1.0, -fork_h / 2.0 - 1.0))
    fork_box = fork_box.cut(trim_box).fuse(tip_cyl)

    slot = Part.makeBox(CLEVIS_FORK_LEN + 2.0, CLEVIS_GAP, fork_h + 4.0,
                        App.Vector(CLEVIS_BODY_LEN + 2.0, -CLEVIS_GAP / 2.0, -fork_h / 2.0 - 2.0))
    fork_box = fork_box.cut(slot)

    pin_x = CLEVIS_BODY_LEN + CLEVIS_FORK_LEN - fork_h / 2.0
    pin_hole = Part.makeCylinder(CLEVIS_PIN_DIA / 2.0, fork_w + 4.0,
                                 App.Vector(pin_x, -fork_w / 2.0 - 2.0, 0),
                                 App.Vector(0, 1, 0))
    fork_box = fork_box.cut(pin_hole)

    return base.fuse(fork_box)

def build_thrust_bearing(doc, name, x_start):
    """Builds a 51103 thrust bearing (2 washers + ball ring) starting at x_start."""
    w1 = Part.makeCylinder(BRG_OD / 2.0, BRG_WASHER_THICK, App.Vector(x_start, 0, 0), App.Vector(1, 0, 0)).cut(
         Part.makeCylinder(BRG_ID / 2.0, BRG_WASHER_THICK + 2, App.Vector(x_start - 1, 0, 0), App.Vector(1, 0, 0)))

    w2_x = x_start + BRG_THICK - BRG_WASHER_THICK
    w2 = Part.makeCylinder(BRG_OD / 2.0, BRG_WASHER_THICK, App.Vector(w2_x, 0, 0), App.Vector(1, 0, 0)).cut(
         Part.makeCylinder(BRG_ID / 2.0, BRG_WASHER_THICK + 2, App.Vector(w2_x - 1, 0, 0), App.Vector(1, 0, 0)))

    balls = []
    pitch_r = (BRG_OD + BRG_ID) / 4.0
    ball_x = x_start + BRG_THICK / 2.0
    for i in range(NUM_BALLS):
        ang = 2.0 * math.pi * i / NUM_BALLS
        b = Part.makeSphere(BALL_DIA / 2.0, App.Vector(ball_x, pitch_r * math.cos(ang), pitch_r * math.sin(ang)))
        balls.append(b)

    washer_obj = doc.addObject("Part::Feature", name + "_Washers")
    washer_obj.Shape = w1.fuse(w2)
    washer_obj.ViewObject.ShapeColor = (0.20, 0.45, 0.85)  # Steel Blue

    balls_obj = doc.addObject("Part::Feature", name + "_Balls")
    balls_obj.Shape = Part.makeCompound(balls)
    balls_obj.ViewObject.ShapeColor = (0.85, 0.85, 0.90)   # Chrome Silver
    return washer_obj, balls_obj

# ==============================================================================
# MAIN ASSEMBLY GENERATION
# ==============================================================================
doc = App.newDocument("Balljoint Part-B")

chs_right_x = BAFFLE_OFFSET_FROM_RIGHT
chs_left_x = chs_right_x - CHS_LENGTH

# Cutaway box removes the front-top quadrant (-Y, +Z) so internal stack is clearly visible
cut_box = Part.makeBox(400.0, 100.0, 100.0, App.Vector(-200.0, -100.0, 0.0))

# 1. 42mm CHS Outer Tube (with 3 plug-weld holes at X=0)
chs_outer = Part.makeCylinder(CHS_OD / 2.0, CHS_LENGTH, App.Vector(chs_left_x, 0, 0), App.Vector(1, 0, 0))
chs_inner = Part.makeCylinder(CHS_ID / 2.0, CHS_LENGTH + 2.0, App.Vector(chs_left_x - 1, 0, 0), App.Vector(1, 0, 0))
chs_tube = chs_outer.cut(chs_inner)

for ang_deg in [0, 120, 240]:
    rad = math.radians(ang_deg)
    weld_hole = Part.makeCylinder(4.0, CHS_OD, App.Vector(0, 0, 0), App.Vector(0, math.cos(rad), math.sin(rad)))
    chs_tube = chs_tube.cut(weld_hole)

# Cross-bolt holes near left end for removable end plug
pin_x = chs_left_x + PLUG_LEN / 2.0
chs_cross_hole = Part.makeCylinder(CROSS_PIN_DIA / 2.0, CHS_OD + 4.0,
                                   App.Vector(pin_x, 0, -CHS_OD / 2.0 - 2.0), App.Vector(0, 0, 1))
chs_tube = chs_tube.cut(chs_cross_hole)

if CUTAWAY:
    chs_tube = chs_tube.cut(cut_box)

chs_obj = doc.addObject("Part::Feature", "CHS_42mm_Housing")
chs_obj.Shape = chs_tube
chs_obj.ViewObject.ShapeColor = (0.35, 0.38, 0.42)  # Dark Grey Steel

# 2. Internal Welded Baffle Washer (Centered at X=0)
baffle = Part.makeCylinder(BAFFLE_OD / 2.0, BAFFLE_THICK, App.Vector(-BAFFLE_THICK / 2.0, 0, 0), App.Vector(1, 0, 0)).cut(
         Part.makeCylinder(BAFFLE_ID / 2.0, BAFFLE_THICK + 2.0, App.Vector(-BAFFLE_THICK / 2.0 - 1, 0, 0), App.Vector(1, 0, 0)))
if CUTAWAY:
    baffle = baffle.cut(cut_box)

baffle_obj = doc.addObject("Part::Feature", "Internal_Baffle_Washer")
baffle_obj.Shape = baffle
baffle_obj.ViewObject.ShapeColor = (0.75, 0.30, 0.25)  # Oxide Red

# 3. Radial Split PTFE/Bronze Bushing (Centered at X=0)
bushing = Part.makeCylinder(BUSHING_OD / 2.0, BUSHING_LEN, App.Vector(-BUSHING_LEN / 2.0, 0, 0), App.Vector(1, 0, 0)).cut(
          Part.makeCylinder(BUSHING_ID / 2.0, BUSHING_LEN + 2.0, App.Vector(-BUSHING_LEN / 2.0 - 1, 0, 0), App.Vector(1, 0, 0)))
if CUTAWAY:
    bushing = bushing.cut(cut_box)

bushing_obj = doc.addObject("Part::Feature", "Radial_PTFE_Bushing")
bushing_obj.Shape = bushing
bushing_obj.ViewObject.ShapeColor = (0.85, 0.65, 0.20)  # Bronze/Gold

# 4. Dual 51103 Thrust Bearings (Straddling the Baffle Washer)
build_thrust_bearing(doc, "Bearing_Right_Compression", BAFFLE_THICK / 2.0)
build_thrust_bearing(doc, "Bearing_Left_Tension", -BAFFLE_THICK / 2.0 - BRG_THICK)

# 5. M16 Nyloc Nut (Left of Inner Bearing - Tension Clamping)
nyloc_x = -BAFFLE_THICK / 2.0 - BRG_THICK - NYLOC_THICK
nyloc = make_hex_prism(HEX_ACROSS_FLATS, NYLOC_THICK, SHAFT_DIA)
nyloc.translate(App.Vector(nyloc_x, 0, 0))
if CUTAWAY:
    nyloc = nyloc.cut(cut_box)

nyloc_obj = doc.addObject("Part::Feature", "M16_Nyloc_Nut")
nyloc_obj.Shape = nyloc
nyloc_obj.ViewObject.ShapeColor = (0.20, 0.65, 0.35)  # Green

# 6. M16 Thin Jam Nut (Right of Outer Bearing - Compression Shoulder & Clevis Lock)
jam_x = BAFFLE_THICK / 2.0 + BRG_THICK
jam_nut = make_hex_prism(HEX_ACROSS_FLATS, JAM_NUT_THICK, SHAFT_DIA)
jam_nut.translate(App.Vector(jam_x, 0, 0))
if CUTAWAY:
    jam_nut = jam_nut.cut(cut_box)

jam_obj = doc.addObject("Part::Feature", "M16_Jam_Nut")
jam_obj.Shape = jam_nut
jam_obj.ViewObject.ShapeColor = (0.25, 0.75, 0.45)  # Light Green

# 7. M16 Central Shaft
shaft_start_x = nyloc_x - 3.0
shaft = Part.makeCylinder(SHAFT_DIA / 2.0, SHAFT_LENGTH, App.Vector(shaft_start_x, 0, 0), App.Vector(1, 0, 0))
shaft_obj = doc.addObject("Part::Feature", "M16_Swivel_Shaft")
shaft_obj.Shape = shaft
shaft_obj.ViewObject.ShapeColor = (0.78, 0.80, 0.82)  # Bright Steel

# 8. Right Rotating Clevis Fork (Female M16 threaded onto M16 Shaft)
right_clevis_x = jam_x + JAM_NUT_THICK
right_clevis = make_clevis_fork(is_female=True)
right_clevis.translate(App.Vector(right_clevis_x, 0, 0))
if CUTAWAY:
    right_clevis = right_clevis.cut(cut_box)

rc_obj = doc.addObject("Part::Feature", "Clevis_Right_Rotating")
rc_obj.Shape = right_clevis
rc_obj.ViewObject.ShapeColor = (0.55, 0.58, 0.62)

# 9. Left End Plug & Cross-Pin (Serviceable Fixed End)
plug = Part.makeCylinder(CHS_ID / 2.0 - 0.1, PLUG_LEN, App.Vector(chs_left_x, 0, 0), App.Vector(1, 0, 0))
plug = plug.cut(chs_cross_hole)
if CUTAWAY:
    plug = plug.cut(cut_box)

plug_obj = doc.addObject("Part::Feature", "Left_End_Plug")
plug_obj.Shape = plug
plug_obj.ViewObject.ShapeColor = (0.45, 0.48, 0.52)

cross_pin = Part.makeCylinder(CROSS_PIN_DIA / 2.0, CHS_OD + 6.0,
                              App.Vector(pin_x, 0, -CHS_OD / 2.0 - 3.0), App.Vector(0, 0, 1))
cp_obj = doc.addObject("Part::Feature", "Cross_Bolt_M10")
cp_obj.Shape = cross_pin
cp_obj.ViewObject.ShapeColor = (0.80, 0.70, 0.25)

# 10. Left Fixed Clevis Fork (Welded to Left End Plug, rotated 90 deg for U-joint action)
left_clevis = make_clevis_fork(is_female=False)
left_clevis.rotate(App.Vector(0, 0, 0), App.Vector(1, 0, 0), 90)
left_clevis.rotate(App.Vector(0, 0, 0), App.Vector(0, 0, 1), 180)
left_clevis.translate(App.Vector(chs_left_x, 0, 0))

lc_obj = doc.addObject("Part::Feature", "Clevis_Left_Fixed")
lc_obj.Shape = left_clevis
lc_obj.ViewObject.ShapeColor = (0.55, 0.58, 0.62)

doc.recompute()
if App.GuiUp:
    import FreeCADGui
    FreeCADGui.SendMsgToActiveView("ViewFit")
    FreeCADGui.activeDocument().activeView().viewIsometric()
