import FreeCAD as App
import Part
import math

# Concept assembly: pivoting boom, opposed pull-pull capstans and a linear
# actuator whose rod terminates in the M16/12 mm-pin clevis interface used by
# "Balljoint part.fcmacro". Dimensions are millimetres.

# --------------------------- editable dimensions ---------------------------
TUBE_OD = 44.0
TUBE_WALL = 3.2
TUBE_LENGTH = 900.0  # overall tube length, independent of actuator dimensions
ACTUATOR_MIN_LENGTH = 450.0
# The minimum actuator span locates the pivot from the open end. Overall tube
# length determines the remaining pivot-to-cable-anchor reach.
PIVOT_X = ACTUATOR_MIN_LENGTH
PIVOT_TO_CABLE_ATTACHMENT_LENGTH = TUBE_LENGTH - PIVOT_X
CABLE_ATTACHMENT_X = TUBE_LENGTH
PULLEY_OFFSET_Y = 250.0
PULLEY_X = PIVOT_X + PIVOT_TO_CABLE_ATTACHMENT_LENGTH / 2.0
CUTAWAY = True
PIVOT_PIN_DIA = 16.0
PIVOT_PIN_LENGTH = 100.0
BEARING_SPAN = 70.0

MOTOR_DIA = 42.0
MOTOR_LENGTH = 65.0
CAPSTAN_DIA = 28.0
CAPSTAN_WIDTH = 18.0
CABLE_DIA = 2.0

ACTUATOR_BODY_DIA = 32.0  # fits within 37.6 mm tube bore with nominal clearance
ACTUATOR_MAX_LENGTH = 900.0
ACTUATOR_LENGTH = ACTUATOR_MAX_LENGTH  # displayed pose; set min..max
ACTUATOR_STROKE = ACTUATOR_MAX_LENGTH - ACTUATOR_MIN_LENGTH
ACTUATOR_BODY_LENGTH = ACTUATOR_MIN_LENGTH
ROD_DIA = 16.0
ROD_NOSE_MIN = 5.0  # short nose in minimum state; clevis sits just outside tube
CLEVIS_GAP = 14.0
CLEVIS_EAR = 6.0
CLEVIS_PIN_DIA = 12.0
CLEVIS_BODY_DIA = 26.0

BASE_WIDTH = 2.0 * (PULLEY_OFFSET_Y + MOTOR_DIA/2.0 + 10.0)
BASE_LENGTH = PULLEY_X - PIVOT_X + 200.0
BASE_X = PIVOT_X - 75.0
BASE_THICK = 10.0
YOKE_GAP = 56.0
YOKE_THICK = 8.0
YOKE_HEIGHT = 95.0

# Coordinate convention: tube axis X; yaw occurs in the XY plane; Z is the
# normal to that plane and the pivot axis. Neutral pose points along +X.

doc = App.newDocument("drawbar")

def add_part(name, shape, color, transparency=0):
    obj = doc.addObject("Part::Feature", name.replace(" ", "_"))
    obj.Label = name
    obj.Shape = shape
    obj.ViewObject.ShapeColor = color
    obj.ViewObject.LineColor = (0.12, 0.12, 0.12)
    obj.ViewObject.Transparency = transparency
    return obj

def cylinder_x(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(1, 0, 0))

def cylinder_y(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(0, 1, 0))

def cylinder_z(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(0, 0, 1))

def tube_x(od, wall, length, x, y, z):
    outer = cylinder_x(od / 2.0, length, x, y, z)
    inner = cylinder_x(od / 2.0-wall, length+2, x-1, y, z)
    return outer.cut(inner)

def make_clevis():
    """Female threaded clevis aligned along +X, matching the supplied macro."""
    body_len, fork_len = 22.0, 32.0
    fork_width = CLEVIS_GAP + 2*CLEVIS_EAR
    fork_height = CLEVIS_BODY_DIA
    body = cylinder_x(CLEVIS_BODY_DIA/2, body_len, 0, 0, 0)
    body = body.cut(cylinder_x(8.0, body_len+2, -1, 0, 0))
    fork = Part.makeBox(fork_len, fork_width, fork_height,
                        App.Vector(body_len-2, -fork_width/2, -fork_height/2))
    tipx = body_len + fork_len - fork_height/2
    tip = Part.makeCylinder(fork_height/2, fork_width,
                            App.Vector(tipx, -fork_width/2, 0), App.Vector(0,1,0))
    trim = Part.makeBox(fork_height, fork_width+2, fork_height+2,
                        App.Vector(tipx, -fork_width/2-1, -fork_height/2-1))
    fork = fork.cut(trim).fuse(tip)
    slot = Part.makeBox(fork_len+2, CLEVIS_GAP, fork_height+4,
                        App.Vector(body_len+2, -CLEVIS_GAP/2, -fork_height/2-2))
    fork = fork.cut(slot)
    pinx = body_len + fork_len - fork_height/2
    hole = Part.makeCylinder(CLEVIS_PIN_DIA/2, fork_width+4,
                             App.Vector(pinx, -fork_width/2-2, 0), App.Vector(0,1,0))
    return body.fuse(fork.cut(hole))

# Ground support plate below pivot and motor pair, with cheeks along Z.
add_part("Ground mounting plate", Part.makeBox(BASE_LENGTH, BASE_WIDTH, BASE_THICK,
         App.Vector(BASE_X, -BASE_WIDTH/2, -45)), (0.30,0.32,0.35))
for side in (-1, 1):
    z0 = side * (YOKE_GAP/2 + YOKE_THICK/2)
    cheek = Part.makeBox(42, YOKE_HEIGHT, YOKE_THICK,
                         App.Vector(PIVOT_X-21, -YOKE_HEIGHT/2, z0-YOKE_THICK/2))
    bore = cylinder_z(PIVOT_PIN_DIA/2+0.4, YOKE_THICK+2, PIVOT_X, 0, z0-YOKE_THICK/2-1)
    cheek = cheek.cut(bore)
    add_part("Pivot support cheek " + ("L" if side < 0 else "R"), cheek, (0.42,0.45,0.49))

# Boom tube, hollow so its section can be inspected by hiding this object.
boom_y = 0.0
tube_shape = tube_x(TUBE_OD, TUBE_WALL, TUBE_LENGTH, 0, boom_y, 0)
if CUTAWAY:
    # Remove the +Y longitudinal half to expose the actuator while retaining
    # the lower half-shell as a section view.
    section_tool = Part.makeBox(TUBE_LENGTH+2, TUBE_OD, TUBE_OD+2,
                                App.Vector(-1, 0, -TUBE_OD/2-1))
    tube_shape = tube_shape.cut(section_tool)
add_part("Pivoting 44 mm tube (longitudinal cutaway)", tube_shape,
         (0.68,0.70,0.73), 0)

# Pivot axle and bearing collars on both sides of the tube.
add_part("Z axis yaw pivot axle", cylinder_z(PIVOT_PIN_DIA/2, PIVOT_PIN_LENGTH, PIVOT_X, 0, -PIVOT_PIN_LENGTH/2),
         (0.78,0.79,0.81))
ring = cylinder_z(19, 12, PIVOT_X, 0, -6).cut(cylinder_z(8.2,14,PIVOT_X,0,-7))
add_part("Yaw pivot bearing collar", ring, (0.78,0.65,0.28))

# Grounded motors are mirrored in Y, on the plate and on the pulley side.
# Their Y coordinates match the pulley centre lines.
for side in (-1,1):
    my = side*PULLEY_OFFSET_Y
    mx = PIVOT_X + 20.0
    motor = cylinder_z(MOTOR_DIA/2, MOTOR_LENGTH, mx, my, -BASE_THICK-35)
    add_part("Pull motor " + ("L" if side < 0 else "R"), motor, (0.20,0.27,0.34))
    shaft = cylinder_z(6, 14, mx, my, MOTOR_LENGTH/2)
    add_part("Motor output shaft " + str(side), shaft, (0.72,0.73,0.75))
    drum = cylinder_z(CAPSTAN_DIA/2, CAPSTAN_WIDTH, mx, my, MOTOR_LENGTH/2+12)
    add_part("Cable capstan " + str(side), drum, (0.83,0.49,0.15))
# Cable lines from far-end tube anchors to the redirect pulleys, then down to
# the grounded capstans. Lines are schematic straight runs in this pose.
for side in (-1,1):
    my = side*PULLEY_OFFSET_Y
    mx = PIVOT_X + 20.0
    sx = PULLEY_X
    sy = side*PULLEY_OFFSET_Y
    sheave = cylinder_z(24, 10, sx, sy, -5)
    add_part("Cable redirect pulley " + str(side), sheave, (0.86,0.67,0.20))
    support = Part.makeBox(20,20,30,App.Vector(sx-10,sy-10,-35))
    add_part("Redirect pulley support " + str(side), support, (0.42,0.45,0.49))
    p0 = App.Vector(CABLE_ATTACHMENT_X-4, side*(TUBE_OD/2.0), 0)
    p1 = App.Vector(sx, sy, 0)
    v = p1.sub(p0)
    add_part("Far end cable run " + str(side), Part.makeCylinder(CABLE_DIA/2,v.Length,p0,v.normalize()), (0.85,0.20,0.16))
    anchor = cylinder_z(4,18,CABLE_ATTACHMENT_X-8,side*(TUBE_OD/2.0),-9)
    add_part("Far end cable anchor " + str(side), anchor, (0.75,0.75,0.78))
    p2 = App.Vector(sx, sy, 0)
    p3 = App.Vector(mx, my, MOTOR_LENGTH/2+30)
    v2 = p3.sub(p2)
    add_part("Capstan lead " + str(side), Part.makeCylinder(CABLE_DIA/2,v2.Length,p2,v2.normalize()), (0.85,0.20,0.16))

# Actuator occupies the open-end side. Its minimum length determines the
# open-end-to-pivot span; the remaining tube span reaches the cable anchor.
if ACTUATOR_LENGTH < ACTUATOR_MIN_LENGTH or ACTUATOR_LENGTH > ACTUATOR_MAX_LENGTH:
    raise ValueError("ACTUATOR_LENGTH must be within the min/max range")
body_start = PIVOT_X - ACTUATOR_BODY_LENGTH
rod_root_x = body_start
body_end = body_start + ACTUATOR_BODY_LENGTH
body = cylinder_x(ACTUATOR_BODY_DIA/2, ACTUATOR_BODY_LENGTH, body_start, boom_y, 0)
add_part("Internal linear actuator housing", body, (0.20,0.36,0.56))
rear_cap_x = body_end
rear_cap = cylinder_x(ACTUATOR_BODY_DIA/2+2, 8, rear_cap_x, boom_y, 0)
add_part("Actuator rear cap inside tube", rear_cap, (0.30,0.32,0.35))
ACTUATOR_EXTENSION = ACTUATOR_LENGTH - ACTUATOR_MIN_LENGTH
rod_length = max(ROD_NOSE_MIN, ACTUATOR_EXTENSION)
rod_x = rod_root_x-rod_length
rod = cylinder_x(ROD_DIA/2, rod_length, rod_x, boom_y, 0)
add_part("Actuator rod (parameterized extension)", rod, (0.82,0.83,0.85))

# Threaded M16 adapter and clevis face outward from the selected tube end.
rod_tip_x = rod_x
adapter_x = rod_tip_x-18
adapter = cylinder_x(8,18,adapter_x,boom_y,0)
add_part("M16 clevis adapter", adapter, (0.72,0.73,0.75))
clevis = make_clevis()
clevis.rotate(App.Vector(0,0,0),App.Vector(0,1,0),180)
clevis_x = adapter_x+18
pinx = clevis_x-22-32+13
clevis.translate(App.Vector(clevis_x,boom_y,0))
add_part("Actuator clevis for supplied balljoint", clevis, (0.55,0.58,0.62))
pin = Part.makeCylinder(CLEVIS_PIN_DIA/2, CLEVIS_GAP+2*CLEVIS_EAR+8,
                        App.Vector(pinx, boom_y-CLEVIS_GAP/2-CLEVIS_EAR-4, 0), App.Vector(0,1,0))
add_part("Clevis cross pin 12 mm", pin, (0.82,0.70,0.24))

# Record the desired yaw range in the model tree.
yaw = doc.addObject("App::FeaturePython", "YawRangeNote")
yaw.Label = "Yaw range: -85 deg to +85 deg from neutral"
yaw.addProperty("App::PropertyAngle", "MinimumYaw", "Motion")
yaw.MinimumYaw = -85
yaw.addProperty("App::PropertyAngle", "MaximumYaw", "Motion")
yaw.MaximumYaw = 85
yaw.addProperty("App::PropertyLength", "TubeOD", "Dimensions")
yaw.TubeOD = TUBE_OD
yaw.addProperty("App::PropertyLength", "PivotToCableAttachmentLength", "Dimensions")
yaw.PivotToCableAttachmentLength = PIVOT_TO_CABLE_ATTACHMENT_LENGTH
yaw.addProperty("App::PropertyLength", "CableAttachmentX", "Dimensions")
yaw.CableAttachmentX = CABLE_ATTACHMENT_X
yaw.addProperty("App::PropertyLength", "TubeLength", "Dimensions")
yaw.TubeLength = TUBE_LENGTH
yaw.addProperty("App::PropertyBool", "CutawayView", "Configuration")
yaw.CutawayView = CUTAWAY
yaw.addProperty("App::PropertyLength", "PivotPositionX", "Dimensions")
yaw.PivotPositionX = PIVOT_X
yaw.addProperty("App::PropertyLength", "PulleyOffsetY", "Dimensions")
yaw.PulleyOffsetY = PULLEY_OFFSET_Y
yaw.addProperty("App::PropertyLength", "ActuatorMinLength", "Dimensions")
yaw.ActuatorMinLength = ACTUATOR_MIN_LENGTH
yaw.addProperty("App::PropertyLength", "ActuatorMaxLength", "Dimensions")
yaw.ActuatorMaxLength = ACTUATOR_MAX_LENGTH
yaw.addProperty("App::PropertyLength", "ActuatorDisplayedLength", "Dimensions")
yaw.ActuatorDisplayedLength = ACTUATOR_LENGTH

doc.recompute()
if App.GuiUp:
    import FreeCADGui as Gui
    Gui.activeDocument().activeView().viewIsometric()
    Gui.activeDocument().activeView().fitAll()
