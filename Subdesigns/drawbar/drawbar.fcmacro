import FreeCAD as App
import Part
import math

# Concept assembly: pivoting boom driven by a toothed sector fixed to the bar, a pinion and a planetary gearmotor,
# plus a linear actuator whose rod ends in the M16/12 mm-pin clevis interface used by "Balljoint part.fcmacro".
# Replaces the earlier pull-pull cable/capstan drive, whose cable lever arm dropped to zero part way through the swing:
# a sector concentric with the pivot gives the same lever arm (the sector pitch radius) at every angle.
# Dimensions are millimetres. Z is the pivot axis, the bar yaws in the XY plane, neutral pose points along +X.

# --------------------------- editable dimensions ---------------------------
TUBE_OD = 44.0
TUBE_WALL = 3.2
TUBE_LENGTH = 900.0  # overall tube length, independent of actuator dimensions
ACTUATOR_MIN_LENGTH = 450.0
# The minimum actuator span locates the pivot from the open end.
PIVOT_X = ACTUATOR_MIN_LENGTH
PIVOT_TO_TIP_LENGTH = TUBE_LENGTH - PIVOT_X
CUTAWAY = True
PIVOT_PIN_DIA = 16.0
BEARING_SPAN = 70.0
YAW_LIMIT_DEG = 85.0  # mechanical stop either side of neutral

ACTUATOR_BODY_DIA = 32.0  # fits within 37.6 mm tube bore with nominal clearance
ACTUATOR_MAX_LENGTH = 900.0
ACTUATOR_LENGTH = ACTUATOR_MAX_LENGTH  # displayed pose; set min..max
ACTUATOR_STROKE = ACTUATOR_MAX_LENGTH - ACTUATOR_MIN_LENGTH
ACTUATOR_BODY_LENGTH = ACTUATOR_MIN_LENGTH
ROD_DIA = 16.0
ROD_NOSE_MIN = 5.0  # short nose in minimum state; clevis sits just outside tube
CLEVIS_GAP = 14.0
CLEVIS_EAR = 6.0
CLEVIS_PIN_DIA = 12.0
CLEVIS_BODY_DIA = 26.0

# Sector + pinion drive (all of it hangs UNDER the mounting plate, so nothing in the drive crosses the swept bar).
SECTOR_MODULE = 2.0
SECTOR_TEETH = 120            # sector pitch radius = module * teeth / 2 = 120 mm
PINION_TEETH = 15             # pinion pitch radius = 15 mm (15 teeth: mild undercut, use a profile shift)
SECTOR_FACE = 15.0            # gear face width
SECTOR_ARC_DEG = 2.0 * (YAW_LIMIT_DEG + 5.0)   # 5 deg of extra teeth past each stop
PLANETARY_RATIO = 10.0        # gearmotor reduction ahead of the pinion
DRIVE_EFFICIENCY = 0.8        # whole train, motor to bar
MOTOR_PEAK_TORQUE_NM = 2.0    # same cap as the simulation's drive motor
MOTOR_DIA = 42.0
MOTOR_LENGTH = 65.0
GEARBOX_LENGTH = 55.0
SECTOR_RATIO = SECTOR_TEETH / PINION_TEETH
TOTAL_RATIO = SECTOR_RATIO * PLANETARY_RATIO
BAR_TORQUE_NM = MOTOR_PEAK_TORQUE_NM * TOTAL_RATIO * DRIVE_EFFICIENCY   # about 128 N.m at the bar
SECTOR_PITCH_R = SECTOR_MODULE * SECTOR_TEETH / 2.0
PINION_PITCH_R = SECTOR_MODULE * PINION_TEETH / 2.0
PINION_X = PIVOT_X + SECTOR_PITCH_R + PINION_PITCH_R

# Layer heights (Z, mm). Bar at 0; plate under the bar; sector under the plate.
PLATE_Z0 = -45.0
BASE_THICK = 10.0
SECTOR_GAP = 4.0
SECTOR_Z1 = PLATE_Z0 - SECTOR_GAP
SECTOR_Z0 = SECTOR_Z1 - SECTOR_FACE
PIVOT_PIN_Z0 = SECTOR_Z0 - 3.0
PIVOT_PIN_Z1 = 50.0
PIVOT_PIN_LENGTH = PIVOT_PIN_Z1 - PIVOT_PIN_Z0
STUB_LENGTH = 16.0
FLANGE_THICK = 6.0
FLANGE_Z1 = SECTOR_Z0 - 8.0

BASE_X = PIVOT_X - 75.0
BASE_LENGTH = 75.0 + SECTOR_PITCH_R + PINION_PITCH_R + 80.0
BASE_WIDTH = 2.0 * (SECTOR_PITCH_R + 30.0)
YOKE_GAP = 56.0
YOKE_THICK = 8.0
YOKE_HEIGHT = 95.0

doc = App.newDocument("drawbar")

def add_part(name, shape, color, transparency=0):
    obj = doc.addObject("Part::Feature", name.replace(" ", "_"))
    obj.Label = name
    obj.Shape = shape
    obj.ViewObject.ShapeColor = color
    obj.ViewObject.LineColor = (0.12, 0.12, 0.12)
    obj.ViewObject.Transparency = transparency
    return obj

def cylinder_x(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(1, 0, 0))

def cylinder_y(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(0, 1, 0))

def cylinder_z(radius, length, x, y, z):
    return Part.makeCylinder(radius, length, App.Vector(x, y, z), App.Vector(0, 0, 1))

def tube_x(od, wall, length, x, y, z):
    outer = cylinder_x(od / 2.0, length, x, y, z)
    inner = cylinder_x(od / 2.0-wall, length+2, x-1, y, z)
    return outer.cut(inner)

def make_clevis():
    """Female threaded clevis aligned along +X, matching the supplied macro."""
    body_len, fork_len = 22.0, 32.0
    fork_width = CLEVIS_GAP + 2*CLEVIS_EAR
    fork_height = CLEVIS_BODY_DIA
    body = cylinder_x(CLEVIS_BODY_DIA/2, body_len, 0, 0, 0)
    body = body.cut(cylinder_x(8.0, body_len+2, -1, 0, 0))
    fork = Part.makeBox(fork_len, fork_width, fork_height,
                        App.Vector(body_len-2, -fork_width/2, -fork_height/2))
    tipx = body_len + fork_len - fork_height/2
    tip = Part.makeCylinder(fork_height/2, fork_width,
                            App.Vector(tipx, -fork_width/2, 0), App.Vector(0,1,0))
    trim = Part.makeBox(fork_height, fork_width+2, fork_height+2,
                        App.Vector(tipx, -fork_width/2-1, -fork_height/2-1))
    fork = fork.cut(trim).fuse(tip)
    slot = Part.makeBox(fork_len+2, CLEVIS_GAP, fork_height+4,
                        App.Vector(body_len+2, -CLEVIS_GAP/2, -fork_height/2-2))
    fork = fork.cut(slot)
    pinx = body_len + fork_len - fork_height/2
    hole = Part.makeCylinder(CLEVIS_PIN_DIA/2, fork_width+4,
                             App.Vector(pinx, -fork_width/2-2, 0), App.Vector(0,1,0))
    return body.fuse(fork.cut(hole))

# Ground support plate (the trailer deck) with pivot cheeks along Z.
add_part("Ground mounting plate", Part.makeBox(BASE_LENGTH, BASE_WIDTH, BASE_THICK,
         App.Vector(BASE_X, -BASE_WIDTH/2, PLATE_Z0)), (0.30,0.32,0.35))
for side in (-1, 1):
    z0 = side * (YOKE_GAP/2 + YOKE_THICK/2)
    cheek = Part.makeBox(42, YOKE_HEIGHT, YOKE_THICK,
                         App.Vector(PIVOT_X-21, -YOKE_HEIGHT/2, z0-YOKE_THICK/2))
    bore = cylinder_z(PIVOT_PIN_DIA/2+0.4, YOKE_THICK+2, PIVOT_X, 0, z0-YOKE_THICK/2-1)
    cheek = cheek.cut(bore)
    add_part("Pivot support cheek " + ("L" if side < 0 else "R"), cheek, (0.42,0.45,0.49))

# Boom tube, hollow so its section can be inspected by hiding this object.
boom_y = 0.0
tube_shape = tube_x(TUBE_OD, TUBE_WALL, TUBE_LENGTH, 0, boom_y, 0)
if CUTAWAY:
    # Remove the +Y longitudinal half to expose the actuator while retaining
    # the lower half-shell as a section view.
    section_tool = Part.makeBox(TUBE_LENGTH+2, TUBE_OD, TUBE_OD+2,
                                App.Vector(-1, 0, -TUBE_OD/2-1))
    tube_shape = tube_shape.cut(section_tool)
add_part("Pivoting 44 mm tube (longitudinal cutaway)", tube_shape,
         (0.68,0.70,0.73), 0)

# Pivot axle: fixed to the tube, runs in the cheeks and the plate, and carries the sector below the plate.
add_part("Z axis yaw pivot axle", cylinder_z(PIVOT_PIN_DIA/2, PIVOT_PIN_LENGTH, PIVOT_X, 0, PIVOT_PIN_Z0),
         (0.78,0.79,0.81))
ring = cylinder_z(19, 12, PIVOT_X, 0, -6).cut(cylinder_z(8.2,14,PIVOT_X,0,-7))
add_part("Yaw pivot bearing collar", ring, (0.78,0.65,0.28))

# Toothed sector (rim at the tip circle; tooth form not modelled), fixed to the axle, spanning the yaw range plus margin.
tip_r = SECTOR_PITCH_R + SECTOR_MODULE
sector = cylinder_z(tip_r, SECTOR_FACE, PIVOT_X, 0, SECTOR_Z0)
half = math.radians(SECTOR_ARC_DEG / 2.0)
far = 3.0 * tip_r
wpts = [App.Vector(PIVOT_X, 0, SECTOR_Z0 - 1.0)]
for k in range(5):
    a = -half + 2.0 * half * k / 4.0
    wpts.append(App.Vector(PIVOT_X + far * math.cos(a), far * math.sin(a), SECTOR_Z0 - 1.0))
wpts.append(wpts[0])
wedge = Part.Face(Part.makePolygon(wpts)).extrude(App.Vector(0, 0, SECTOR_FACE + 2.0))
sector = sector.common(wedge)
sector = sector.cut(cylinder_z(PIVOT_PIN_DIA/2, SECTOR_FACE + 2.0, PIVOT_X, 0, SECTOR_Z0 - 1.0))
add_part("Drive sector (120T, module 2)", sector, (0.83,0.49,0.15))

# Pinion, output stub, hanging bracket, planetary gearbox and motor, all grounded under the plate.
add_part("Drive pinion (15T)", cylinder_z(PINION_PITCH_R + SECTOR_MODULE, SECTOR_FACE, PINION_X, 0, SECTOR_Z0),
         (0.86,0.67,0.20))
add_part("Pinion shaft stub", cylinder_z(6, STUB_LENGTH, PINION_X, 0, SECTOR_Z0 - STUB_LENGTH), (0.72,0.73,0.75))
flange = Part.makeBox(50, 76, FLANGE_THICK, App.Vector(PINION_X-10, -38, FLANGE_Z1-FLANGE_THICK))
add_part("Gearmotor mounting flange", flange, (0.42,0.45,0.49))
for side in (-1, 1):
    cheek = Part.makeBox(50, 8, PLATE_Z0 - (FLANGE_Z1-FLANGE_THICK) + FLANGE_THICK,
                         App.Vector(PINION_X-10, side*34 - 4, FLANGE_Z1-FLANGE_THICK))
    add_part("Gearmotor hanger " + ("L" if side < 0 else "R"), cheek, (0.42,0.45,0.49))
gb_z0 = FLANGE_Z1 - FLANGE_THICK - GEARBOX_LENGTH
add_part("Planetary gearbox (10:1)", cylinder_z(MOTOR_DIA/2, GEARBOX_LENGTH, PINION_X, 0, gb_z0), (0.30,0.36,0.44))
add_part("Drive motor", cylinder_z(MOTOR_DIA/2, MOTOR_LENGTH, PINION_X, 0, gb_z0 - MOTOR_LENGTH), (0.20,0.27,0.34))

# Actuator occupies the open-end side. Its minimum length determines the
# open-end-to-pivot span; the remaining tube span reaches the cable anchor.
if ACTUATOR_LENGTH < ACTUATOR_MIN_LENGTH or ACTUATOR_LENGTH > ACTUATOR_MAX_LENGTH:
    raise ValueError("ACTUATOR_LENGTH must be within the min/max range")
body_start = PIVOT_X - ACTUATOR_BODY_LENGTH
rod_root_x = body_start
body_end = body_start + ACTUATOR_BODY_LENGTH
body = cylinder_x(ACTUATOR_BODY_DIA/2, ACTUATOR_BODY_LENGTH, body_start, boom_y, 0)
add_part("Internal linear actuator housing", body, (0.20,0.36,0.56))
rear_cap_x = body_end
rear_cap = cylinder_x(ACTUATOR_BODY_DIA/2+2, 8, rear_cap_x, boom_y, 0)
add_part("Actuator rear cap inside tube", rear_cap, (0.30,0.32,0.35))
ACTUATOR_EXTENSION = ACTUATOR_LENGTH - ACTUATOR_MIN_LENGTH
rod_length = max(ROD_NOSE_MIN, ACTUATOR_EXTENSION)
rod_x = rod_root_x-rod_length
rod = cylinder_x(ROD_DIA/2, rod_length, rod_x, boom_y, 0)
add_part("Actuator rod (parameterized extension)", rod, (0.82,0.83,0.85))

# Threaded M16 adapter and clevis face outward from the selected tube end.
rod_tip_x = rod_x
adapter_x = rod_tip_x-18
adapter = cylinder_x(8,18,adapter_x,boom_y,0)
add_part("M16 clevis adapter", adapter, (0.72,0.73,0.75))
clevis = make_clevis()
clevis.rotate(App.Vector(0,0,0),App.Vector(0,1,0),180)
clevis_x = adapter_x+18
pinx = clevis_x-22-32+13
clevis.translate(App.Vector(clevis_x,boom_y,0))
add_part("Actuator clevis for supplied balljoint", clevis, (0.55,0.58,0.62))
pin = Part.makeCylinder(CLEVIS_PIN_DIA/2, CLEVIS_GAP+2*CLEVIS_EAR+8,
                        App.Vector(pinx, boom_y-CLEVIS_GAP/2-CLEVIS_EAR-4, 0), App.Vector(0,1,0))
add_part("Clevis cross pin 12 mm", pin, (0.82,0.70,0.24))

# Record the desired yaw range and drive parameters in the model tree.
yaw = doc.addObject("App::FeaturePython", "YawRangeNote")
yaw.Label = "Yaw range: -85 deg to +85 deg from neutral (sector drive)"
def add_prop(kind, name, group, value):
    yaw.addProperty(kind, name, group)
    setattr(yaw, name, value)
add_prop("App::PropertyAngle", "MinimumYaw", "Motion", -YAW_LIMIT_DEG)
add_prop("App::PropertyAngle", "MaximumYaw", "Motion", YAW_LIMIT_DEG)
add_prop("App::PropertyLength", "TubeOD", "Dimensions", TUBE_OD)
add_prop("App::PropertyLength", "TubeLength", "Dimensions", TUBE_LENGTH)
add_prop("App::PropertyLength", "PivotToTipLength", "Dimensions", PIVOT_TO_TIP_LENGTH)
add_prop("App::PropertyLength", "PivotPositionX", "Dimensions", PIVOT_X)
add_prop("App::PropertyLength", "ActuatorMinLength", "Dimensions", ACTUATOR_MIN_LENGTH)
add_prop("App::PropertyLength", "ActuatorMaxLength", "Dimensions", ACTUATOR_MAX_LENGTH)
add_prop("App::PropertyLength", "ActuatorDisplayedLength", "Dimensions", ACTUATOR_LENGTH)
add_prop("App::PropertyLength", "SectorPitchRadius", "Drive", SECTOR_PITCH_R)
add_prop("App::PropertyLength", "PinionPitchRadius", "Drive", PINION_PITCH_R)
add_prop("App::PropertyFloat", "PlanetaryRatio", "Drive", PLANETARY_RATIO)
add_prop("App::PropertyFloat", "TotalRatio", "Drive", TOTAL_RATIO)
add_prop("App::PropertyFloat", "BarTorqueNm", "Drive", BAR_TORQUE_NM)
add_prop("App::PropertyBool", "CutawayView", "Configuration", CUTAWAY)

doc.recompute()
if App.GuiUp:
    import FreeCADGui as Gui
    Gui.activeDocument().activeView().viewIsometric()
    Gui.activeDocument().activeView().fitAll()
