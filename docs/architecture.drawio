<mxfile host="app.diagrams.net"><diagram name="AGV control structure" id="agv1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="1  Inputs" style="swimlane;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="560" as="geometry"/></mxCell><mxCell id="n3" value="2  Lead steering (path following)" style="swimlane;horizontal=1;startSize=26;fillColor=#e1f0ff;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="330" height="560" as="geometry"/></mxCell><mxCell id="n4" value="3  What the followers are told" style="swimlane;horizontal=1;startSize=26;fillColor=#e8f6e1;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="640" y="20" width="330" height="560" as="geometry"/></mxCell><mxCell id="n5" value="4  Hitch laws (per hitch j)" style="swimlane;horizontal=1;startSize=26;fillColor=#fff2d6;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="990" y="20" width="360" height="560" as="geometry"/></mxCell><mxCell id="n6" value="5  Wheel laws" style="swimlane;horizontal=1;startSize=26;fillColor=#fde4e4;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="1370" y="20" width="350" height="560" as="geometry"/></mxCell><mxCell id="n7" value="6  Actuators (MuJoCo)" style="swimlane;horizontal=1;startSize=26;fillColor=#ece4f7;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="1740" y="20" width="330" height="560" as="geometry"/></mxCell><mxCell id="n8" value="Config layers&lt;br&gt;common.toml &lt; &lt;Preset&gt;.toml &lt; test files &lt; --set&lt;br&gt;(config.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="220" height="120" as="geometry"/></mxCell><mxCell id="n9" value="Waypoints (active_path)&lt;br&gt;e.g. u_turn_wide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="200" width="220" height="90" as="geometry"/></mxCell><mxCell id="n10" value="IR camera (per hitch)&lt;br&gt;relative yaw / pitch / roll of trailer j+1 in trailer j&lt;br&gt;(ir_camera.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a7ab9;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="320" width="220" height="100" as="geometry"/></mxCell><mxCell id="n11" value="GNSS on the lead -&gt; true speed&lt;br&gt;(gnss.py)  |  IMU per trailer: logged only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a7ab9;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="440" width="220" height="60" as="geometry"/></mxCell><mxCell id="n12" value="Planner (planner.py)&lt;br&gt;rounds corners so the curvature never exceeds what the hitches allow&lt;br&gt;(planner_margin, hitch yaw range); straight run-out past the goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="305" y="60" width="300" height="100" as="geometry"/></mxCell><mxCell id="n13" value="Pure pursuit&lt;br&gt;lookahead = max(lookahead_dist, gain x v); steer to the point ahead on the path&lt;br&gt;kappa_raw = 2 y / L^2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="305" y="180" width="300" height="100" as="geometry"/></mxCell><mxCell id="n14" value="Curvature shaping&lt;br&gt;low-pass + slew limit, in DISTANCE (curv_filter_m, curv_rate_limit_per_m)&lt;br&gt;-&gt; kappa_lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="305" y="300" width="300" height="90" as="geometry"/></mxCell><mxCell id="n15" value="Lead wheel command&lt;br&gt;speed v_cmd (v_center, start ramp)&lt;br&gt;omega_lead = v_cmd x kappa_lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="305" y="410" width="300" height="90" as="geometry"/></mxCell><mxCell id="n16" value="Ideal path reference&lt;br&gt;s_ref = lead's monotone, rate-limited progress along the planned path&lt;br&gt;kappa_ref(s_ref - delay)   (ref_smooth_m smoothing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="655" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="n17" value="Lead deviation&lt;br&gt;(kappa_lead - kappa_ref) low-passed 2 m, clipped&lt;br&gt;so a lead that corrects an error does not drag the chain&lt;br&gt;(ref_dev_gain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="655" y="190" width="300" height="100" as="geometry"/></mxCell><mxCell id="n18" value="kappa_follow(j) = kappa_ref + deviation&lt;br&gt;read at the delay distance of hitch j" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6f0c8;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="310" width="300" height="90" as="geometry"/></mxCell><mxCell id="n19" value="Stall guard (safeguard.py)&lt;br&gt;lead commanded vs GNSS speed: if the lead stalls the followers are scaled down so they do not shove it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="655" y="420" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="Tightness / bar length law (Variable build)&lt;br&gt;tightness = |yaw needed at full length| / yaw range&lt;br&gt;r = r_max - tightness (r_max - r_min), same for front f&lt;br&gt;then shortened further if the hitch pitch would ground the bars (bar_pitch_limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="60" width="330" height="120" as="geometry"/></mxCell><mxCell id="n21" value="Tube yaw law (feed-forward)&lt;br&gt;psi_r = g atan(r kappa_follow), psi_f = g atan(f kappa_follow)&lt;br&gt;each clipped to its tube range; total clipped to the hitch yaw range&lt;br&gt;the ball takes the rest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="200" width="330" height="110" as="geometry"/></mxCell><mxCell id="n22" value="Cable length (main.py / bar_geometry.py)&lt;br&gt;for each of 4 corners: |anchor distance| from&lt;br&gt;psi_r, psi_f (MEASURED), ball yaw = cmd - tubes, ball pitch/roll&lt;br&gt;(held from IR), bar lengths (MEASURED)&lt;br&gt;- preload offset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="330" width="330" height="150" as="geometry"/></mxCell><mxCell id="n23" value="NOTE: bar length and tube yaw are feed-forward on path curvature. There is no feedback on the measured hitch angle here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a000;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="500" width="330" height="70" as="geometry"/></mxCell><mxCell id="n24" value="Follower wheel law (BaseSnakeController._ir_wheel_vels)&lt;br&gt;state (v_j, w_j) of trailer j; psi = MEASURED IR hitch yaw&lt;br&gt;ball position b in trailer j, a in trailer j+1 from the tube yaws and bar lengths&lt;br&gt;ball velocity matches on both sides, no lateral slip of trailer j+1&lt;br&gt;-&gt; (v_{j+1}, w_{j+1});  floor 0.3 v, clip +-3 rad/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1385" y="60" width="320" height="200" as="geometry"/></mxCell><mxCell id="n25" value="Wheel map&lt;br&gt;left = (v - w half_track)/r&lt;br&gt;right = (v + w half_track)/r&lt;br&gt;left turn -&gt; RIGHT wheel faster&lt;br&gt;followers x guard scale, all x start ramp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbd5d5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1385" y="280" width="320" height="110" as="geometry"/></mxCell><mxCell id="n26" value="Wheel motors (velocity actuators)&lt;br&gt;m_t{i}_l, m_t{i}_r" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1755" y="60" width="300" height="80" as="geometry"/></mxCell><mxCell id="n27" value="Telescoping bars (position actuators)&lt;br&gt;act_slide_rear_j, act_slide_front_j+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1755" y="160" width="300" height="80" as="geometry"/></mxCell><mxCell id="n28" value="Tube yaw hinges (position actuators)&lt;br&gt;act_yaw_rear_j, act_yaw_front_j+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1755" y="260" width="300" height="80" as="geometry"/></mxCell><mxCell id="n29" value="Cable capstans (tendon length, pull only)&lt;br&gt;cap_t{j}_t{j+1}_tl/tr/bl/br (4 per hitch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1755" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="n30" value="MuJoCo plant: trailers, wheels, passive ball joints, cables as tendons, ground contact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ccf0;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1755" y="460" width="300" height="90" as="geometry"/></mxCell><mxCell id="e31" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="planned path" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="kappa_lead" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="kappa_ref" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n16" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n18" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="lengths" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="measured psi" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n10" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="pitch" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="n10" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" value="ball pitch/roll" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="n10" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e47" value="bar lengths" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n20" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e48" value="tube yaws" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n21" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e49" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="v, w of the lead" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n15" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e53" value="true speed" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n11" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e54" value="commanded speed" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" value="scale" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n19" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e56" value="" style="endArrow=block;html=1;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="n25" target="n