<mxfile host="app.diagrams.net"><diagram name="Forces on one hitch" id="agv2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f101" value="Forces on one hitch (plan view, travelling to the RIGHT): the hitch STABILISES, the wheels STEER" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="f102" value="trailer j+1 (behind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9fb;strokeColor=#2a7ab9;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="130" as="geometry"/></mxCell><mxCell id="f103" value="trailer j (ahead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9fb;strokeColor=#2a7ab9;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="220" height="130" as="geometry"/></mxCell><mxCell id="f105" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="385" y="250" width="30" height="30" as="geometry"/></mxCell><mxCell id="f106" value="bar + ball joint" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="285" width="140" height="20" as="geometry"/></mxCell><mxCell id="f109" value="cables: T_tl+T_bl (left pair)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="220" height="20" as="geometry"/></mxCell><mxCell id="f110" value="cables: T_tr+T_br (right pair)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="330" y="318" width="220" height="20" as="geometry"/></mxCell><mxCell id="f113" value="N (+ tension)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="345" y="232" width="110" height="20" as="geometry"/></mxCell><mxCell id="f115" value="F_w: wheel thrust (wheel law)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#2e8b57;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="350" width="200" height="20" as="geometry"/></mxCell><mxCell id="f117" value="F_w: wheel thrust" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#2e8b57;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="200" height="20" as="geometry"/></mxCell><mxCell id="f119" value="R: rolling resistance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="160" height="20" as="geometry"/></mxCell><mxCell id="f121" value="net = F_w - R + N  (residual, accelerates the trailer)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#d62728;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="260" height="36" as="geometry"/></mxCell><mxCell id="f123" value="v_des: path tangent + cross-track correction at THIS trailer.&lt;br&gt;The angle to its heading sets the wheel differential." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#7b3fa0;" vertex="1" parent="1"><mxGeometry x="95" y="375" width="340" height="52" as="geometry"/></mxCell><mxCell id="f125" value="travel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="240" width="100" height="20" as="geometry"/></mxCell><mxCell id="f126" value="LOAD CELLS (fixed end of each cable)&lt;br&gt;sum = T_tl+T_tr+T_bl+T_br&lt;br&gt;yaw moment = (T_tl+T_bl) - (T_tr+T_br)&lt;br&gt;pitch moment = (T_tl+T_tr) - (T_bl+T_br)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d6;strokeColor=#d6a000;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="60" width="330" height="120" as="geometry"/></mxCell><mxCell id="f127" value="RULES&lt;br&gt;1. Hitch = preloaded cables: a spring-like restoring torque, NOT an actuator.&lt;br&gt;2. Wheels steer the trailer toward v_des.&lt;br&gt;3. Tow, don't push: keep every hitch in tension.&lt;br&gt;4. COMPRESSION IS A FAILURE: sum &lt; baseline - 30 N =&gt; slow trailer j+1 at once (retension_guard); release over 1 s." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde4e4;strokeColor=#c0392b;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="200" width="330" height="150" as="geometry"/></mxCell><mxCell id="f128" value="OPTIONAL bar sensor (axial force through the bar)&lt;br&gt;Compare with the cable sum: python compare_loads.py&lt;br&gt;If the cable sum tracks it, the bar sensor is not needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f7;strokeColor=#7b3fa0;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="370" width="330" height="110" as="geometry"/></mxCell><mxCell id="f129" value="Bar length is GEOMETRY (how far the trailers cut corners), not a force actuator. Keep it slow; keep forces in the cables and the wheels." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="700" height="60" as="geometry"/></mxCell><mxCell id="f104" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="265" as="sourcePoint"/><mxPoint x="520" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f107" style="endArrow=none;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="215" as="sourcePoint"/><mxPoint x="520" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f108" style="endArrow=none;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="315" as="sourcePoint"/><mxPoint x="520" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f111" value="" style="endArrow=block;html=1;strokeColor=#1f5fbf;strokeWidth=3;fontSize=10;fontColor=#1f5fbf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="265" as="sourcePoint"/><mxPoint x="340" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f112" value="" style="endArrow=block;html=1;strokeColor=#1f5fbf;strokeWidth=3;fontSize=10;fontColor=#1f5fbf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="265" as="sourcePoint"/><mxPoint x="460" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f114" value="" style="endArrow=block;html=1;strokeColor=#2e8b57;strokeWidth=4;fontSize=10;fontColor=#2e8b57;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="345" as="sourcePoint"/><mxPoint x="260" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f116" value="" style="endArrow=block;html=1;strokeColor=#2e8b57;strokeWidth=4;fontSize=10;fontColor=#2e8b57;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="345" as="sourcePoint"/><mxPoint x="720" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f118" value="" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=2;fontSize=10;fontColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="185" as="sourcePoint"/><mxPoint x="40" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f120" value="" style="endArrow=block;html=1;strokeColor=#d62728;strokeWidth=5;fontSize=10;fontColor=#d62728;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="265" as="sourcePoint"/><mxPoint x="230" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f122" value="" style="endArrow=block;html=1;strokeColor=#7b3fa0;strokeWidth=3;fontSize=10;fontColor=#7b3fa0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="265" as="sourcePoint"/><mxPoint x="270" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f124" value="" style="endArrow=block;html=1;strokeColor=#333333;strokeWidth=3;fontSize=10;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="265" as="sourcePoint"/><mxPoint x="880" y="265" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>